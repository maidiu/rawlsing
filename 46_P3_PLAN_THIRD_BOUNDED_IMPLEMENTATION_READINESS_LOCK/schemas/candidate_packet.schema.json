{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rawlsing.local/schemas/p3/v4/candidate_packet.schema.json",
  "title": "candidate_packet",
  "type": "object",
  "required": [
    "packet_id",
    "candidate_family",
    "members_by_source",
    "proposition_signature_matrix",
    "response_contract_matrix",
    "internal_pair_matrix",
    "hard_collisions",
    "unresolved_pairs",
    "unruled_pairs",
    "closure_obligations",
    "likely_split_points",
    "proposed_variants",
    "explicit_exclusions",
    "hyperedge_context",
    "strata_horizon_context",
    "exact_evidence_links",
    "evidence_bundle_hash",
    "decision_form"
  ],
  "properties": {
    "packet_id": {
      "type": "string",
      "pattern": "^P3PKT-[0-9a-f]{16}$"
    },
    "candidate_family": {
      "$ref": "https://rawlsing.local/schemas/p3/v4/candidate_family.schema.json"
    },
    "members_by_source": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "Afrobarometer",
          "Arab Barometer",
          "Asian Barometer",
          "EVS",
          "GSS",
          "Latinobarómetro",
          "LiTS",
          "South Asia",
          "WVS"
        ]
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true,
        "minItems": 1
      },
      "minProperties": 2
    },
    "proposition_signature_matrix": {
      "type": "array",
      "items": {
        "$ref": "https://rawlsing.local/schemas/p3/v4/proposition_signature.schema.json"
      },
      "uniqueItems": true,
      "minItems": 2
    },
    "response_contract_matrix": {
      "type": "array",
      "items": {
        "$ref": "https://rawlsing.local/schemas/p3/v4/response_contract_reference.schema.json"
      },
      "minItems": 2
    },
    "internal_pair_matrix": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "left_id",
          "right_id",
          "pair_state",
          "pair_fact_id",
          "collision_ids",
          "closure_obligation_ids"
        ],
        "properties": {
          "left_id": {
            "type": "string",
            "minLength": 1
          },
          "right_id": {
            "type": "string",
            "minLength": 1
          },
          "pair_state": {
            "enum": [
              "DIRECT_COLLISION",
              "DIRECT_POSITIVE",
              "DIRECT_UNRESOLVED",
              "HIERARCHICAL_ONLY",
              "SIGNATURE_COMPATIBLE",
              "SIGNATURE_CONFLICT",
              "UNRULED"
            ]
          },
          "pair_fact_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^P3PF-[0-9a-f]{16}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "collision_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "closure_obligation_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "hard_collisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "collision_id",
          "collision_type",
          "scope_type",
          "orientation",
          "left_id",
          "right_id"
        ],
        "properties": {
          "collision_id": {
            "type": "string",
            "pattern": "^P3COL-[0-9a-f]{16}$"
          },
          "collision_type": {
            "enum": [
              "BLOCK_BEHAVIOR_DISPOSITION_MERGE",
              "BLOCK_DERIVED_DIRECT_MERGE",
              "BLOCK_GEOGRAPHIC_SCOPE_COLLAPSE",
              "BLOCK_HETEROGENEOUS_LINEAGE",
              "BLOCK_OPERATOR_COLLAPSE",
              "BLOCK_POLARITY_COLLAPSE",
              "BLOCK_POPULATION_SCOPE_COLLAPSE",
              "BLOCK_SAME_PROPOSITION",
              "BLOCK_SAME_VARIANT",
              "BLOCK_SOURCE_STRUCTURE_INFERENCE",
              "BLOCK_TARGET_COLLAPSE",
              "BLOCK_TIMEFRAME_COLLAPSE",
              "BLOCK_VALUE_PORTABILITY",
              "INSUFFICIENT_EVIDENCE",
              "PARENT_CHILD_ONLY",
              "REDIRECT_SEMANTIC_ARTIFACT"
            ]
          },
          "scope_type": {
            "enum": [
              "FAMILY_WIDE",
              "HISTORICAL_INTERVAL",
              "IMPLEMENTATION_PAIR",
              "LINEAGE_PAIR",
              "SEGMENT_PAIR",
              "SOURCE_SPECIFIC",
              "VALUE_PORTABILITY_ONLY",
              "VARIANT_PAIR"
            ]
          },
          "orientation": {
            "enum": [
              "DIRECTIONAL",
              "SYMMETRIC"
            ]
          },
          "left_id": {
            "type": "string",
            "minLength": 1
          },
          "right_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "unresolved_pairs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "left_id",
          "right_id",
          "pair_state",
          "pair_fact_id",
          "collision_ids",
          "closure_obligation_ids"
        ],
        "properties": {
          "left_id": {
            "type": "string",
            "minLength": 1
          },
          "right_id": {
            "type": "string",
            "minLength": 1
          },
          "pair_state": {
            "const": "DIRECT_UNRESOLVED"
          },
          "pair_fact_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^P3PF-[0-9a-f]{16}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "collision_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "closure_obligation_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "unruled_pairs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "left_id",
          "right_id",
          "pair_state",
          "pair_fact_id",
          "collision_ids",
          "closure_obligation_ids"
        ],
        "properties": {
          "left_id": {
            "type": "string",
            "minLength": 1
          },
          "right_id": {
            "type": "string",
            "minLength": 1
          },
          "pair_state": {
            "const": "UNRULED"
          },
          "pair_fact_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^P3PF-[0-9a-f]{16}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "collision_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "closure_obligation_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "closure_obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "obligation_id",
          "obligation_type",
          "status",
          "left_id",
          "right_id"
        ],
        "properties": {
          "obligation_id": {
            "type": "string",
            "pattern": "^P3CLOSE-[0-9a-f]{16}$"
          },
          "obligation_type": {
            "enum": [
              "ATTACHMENT_REVIEW",
              "DIRECT_COLLISION",
              "HETEROGENEOUS_LINEAGE",
              "INCOMPLETE_SIGNATURE",
              "MERGE_OR_SIBLING_REVIEW",
              "SIGNATURE_CONFLICT",
              "UNRESOLVED_PAIR",
              "UNRULED_INTERNAL_PAIR",
              "VALUE_PORTABILITY_BOUNDARY"
            ]
          },
          "status": {
            "enum": [
              "FAIL_CLOSED",
              "OPEN",
              "RESOLVED_ACCEPT",
              "RESOLVED_EXCLUDE",
              "RESOLVED_SPLIT"
            ]
          },
          "left_id": {
            "type": "string",
            "minLength": 1
          },
          "right_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "likely_split_points": {
      "type": "array",
      "items": {
        "$ref": "https://rawlsing.local/schemas/p3/v4/split_point.schema.json"
      }
    },
    "proposed_variants": {
      "type": "array",
      "items": {
        "$ref": "https://rawlsing.local/schemas/p3/v4/variant_assignment.schema.json"
      }
    },
    "explicit_exclusions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://rawlsing.local/schemas/p3/v4/family_exclusion.schema.json"
      }
    },
    "hyperedge_context": {
      "type": "array",
      "items": {
        "$ref": "https://rawlsing.local/schemas/p3/v4/hyperedge.schema.json"
      }
    },
    "strata_horizon_context": {
      "type": "array",
      "items": {
        "$ref": "https://rawlsing.local/schemas/p3/v4/structural_context_reference.schema.json"
      }
    },
    "exact_evidence_links": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 2
    },
    "evidence_bundle_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decision_form": {
      "$ref": "https://rawlsing.local/schemas/p3/v4/adjudication_decision_draft.schema.json"
    }
  },
  "additionalProperties": false
}
