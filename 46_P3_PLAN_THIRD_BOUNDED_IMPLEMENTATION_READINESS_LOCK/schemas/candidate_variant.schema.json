{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rawlsing.local/schemas/p3/v4/candidate_variant.schema.json",
  "title": "candidate_variant",
  "type": "object",
  "required": [
    "variant_id",
    "variant_revision_id",
    "revision_number",
    "owner_object_id",
    "variant_dimension",
    "variant_value",
    "member_ids",
    "value_portability_status",
    "authority_release_id"
  ],
  "properties": {
    "variant_id": {
      "type": "string",
      "pattern": "^P3VAR-[0-9]{6}$"
    },
    "owner_object_id": {
      "type": "string",
      "minLength": 1
    },
    "variant_dimension": {
      "enum": [
        "HISTORICAL_INTERVAL",
        "OTHER_EXPLICITLY_GOVERNED",
        "RESPONSE_TOPOLOGY",
        "SOURCE_RESPONSE_FORM",
        "WORDING_TRANSLATION"
      ]
    },
    "variant_value": {
      "type": "string",
      "minLength": 1
    },
    "member_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "value_portability_status": {
      "const": "NOT_AUTHORIZED_BY_P3"
    },
    "authority_release_id": {
      "type": "string",
      "pattern": "^P3-AUTHORITY-[0-9]{4}-[0-9]{2}-[0-9]{2}-R[0-9]+$"
    },
    "variant_revision_id": {
      "type": "string",
      "pattern": "^P3VARREV-[0-9]{6}-R[0-9]{4}$"
    },
    "revision_number": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
