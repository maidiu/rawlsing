{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rawlsing://field-forge/ffx002-r2/common-semantic-input-manifest.schema.json",
  "title": "FFX002 R2 COMMON_SEMANTIC_INPUT_MANIFEST",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_schema_version",
    "current_execution_sha",
    "observation_substrate_ref",
    "respondent_entity_binding_ref",
    "exposure_risk_set_ref",
    "source_scope_ref",
    "source_native_measurement_refs",
    "qimpl_measurement_binding_refs",
    "response_state_semantics_ref",
    "special_state_semantics_ref",
    "ttar_execution_sequence",
    "post_transform_state_manifest",
    "claim_scope_ref",
    "estimand_ref",
    "weight_design_refs",
    "analytic_role_authority_refs",
    "ancestry_disjointness_receipt",
    "unresolved_noncomparable_manifest",
    "source_native_ancestry_ref",
    "loss_profile",
    "holdout_generation_inputs_hash",
    "canonicalization_spec",
    "manifest_hash"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "opaqueBinding": {
      "description": "Externally supplied immutable authority/artifact binding. The harness does not mint or infer it.",
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "minProperties": 1
        },
        {
          "type": "array",
          "minItems": 1
        }
      ]
    },
    "refSet": {
      "description": "Externally supplied set-valued exact refs. Strings sort by exact value; objects require immutable identity in harness validation.",
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "minProperties": 1
          }
        ]
      }
    }
  },
  "properties": {
    "manifest_schema_version": {
      "const": "FFX002_R2_COMMON_SEMANTIC_INPUT_MANIFEST@1"
    },
    "current_execution_sha": {
      "$ref": "#/$defs/gitSha"
    },
    "observation_substrate_ref": {
      "$ref": "#/$defs/opaqueBinding"
    },
    "respondent_entity_binding_ref": {
      "$ref": "#/$defs/opaqueBinding"
    },
    "exposure_risk_set_ref": {
      "$ref": "#/$defs/opaqueBinding"
    },
    "source_scope_ref": {
      "$ref": "#/$defs/opaqueBinding"
    },
    "source_native_measurement_refs": {
      "$ref": "#/$defs/refSet"
    },
    "qimpl_measurement_binding_refs": {
      "$ref": "#/$defs/refSet"
    },
    "response_state_semantics_ref": {
      "$ref": "#/$defs/opaqueBinding"
    },
    "special_state_semantics_ref": {
      "$ref": "#/$defs/opaqueBinding"
    },
    "ttar_execution_sequence": {
      "description": "Ordered externally supplied TTAR execution sequence, or explicit NONE where lawful.",
      "anyOf": [
        {
          "const": "NONE"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "minProperties": 1
          }
        }
      ]
    },
    "post_transform_state_manifest": {
      "$ref": "#/$defs/opaqueBinding"
    },
    "claim_scope_ref": {
      "$ref": "#/$defs/opaqueBinding"
    },
    "estimand_ref": {
      "$ref": "#/$defs/opaqueBinding"
    },
    "weight_design_refs": {
      "description": "Externally supplied weight/design refs or exact explicit NONE.",
      "anyOf": [
        {
          "const": "NONE"
        },
        {
          "$ref": "#/$defs/refSet"
        }
      ]
    },
    "analytic_role_authority_refs": {
      "$ref": "#/$defs/refSet"
    },
    "ancestry_disjointness_receipt": {
      "$ref": "#/$defs/opaqueBinding"
    },
    "unresolved_noncomparable_manifest": {
      "$ref": "#/$defs/opaqueBinding"
    },
    "source_native_ancestry_ref": {
      "$ref": "#/$defs/opaqueBinding"
    },
    "loss_profile": {
      "$ref": "#/$defs/opaqueBinding"
    },
    "holdout_generation_inputs_hash": {
      "$ref": "#/$defs/sha256"
    },
    "canonicalization_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec_id",
        "encoding",
        "object_key_order",
        "semantic_array_order",
        "set_array_order",
        "set_array_paths",
        "typed_null_empty_distinct",
        "forbid_nonsemantic_timestamps",
        "hash_algorithm",
        "excluded_top_level_hash_fields"
      ],
      "properties": {
        "spec_id": {
          "const": "FFX002_R2_CANONICAL_JSON_SHA256_V1"
        },
        "encoding": {
          "const": "UTF-8"
        },
        "object_key_order": {
          "const": "SORTED_LEXICOGRAPHIC"
        },
        "semantic_array_order": {
          "const": "PRESERVE"
        },
        "set_array_order": {
          "const": "SORT_BY_IMMUTABLE_ID_THEN_CANONICAL_ITEM"
        },
        "set_array_paths": {
          "const": [
            "/analytic_role_authority_refs",
            "/qimpl_measurement_binding_refs",
            "/source_native_measurement_refs",
            "/weight_design_refs"
          ]
        },
        "typed_null_empty_distinct": {
          "const": true
        },
        "forbid_nonsemantic_timestamps": {
          "const": true
        },
        "hash_algorithm": {
          "const": "sha256"
        },
        "excluded_top_level_hash_fields": {
          "const": [
            "manifest_hash"
          ]
        }
      }
    },
    "manifest_hash": {
      "$ref": "#/$defs/sha256"
    }
  }
}
