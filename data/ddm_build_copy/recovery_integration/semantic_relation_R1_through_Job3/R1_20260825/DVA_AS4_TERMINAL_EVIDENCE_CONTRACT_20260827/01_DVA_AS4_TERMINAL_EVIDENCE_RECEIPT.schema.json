        "PERSISTENT_CANONICAL_EMPIRICAL_CARRIER_BYTES": {
          "$ref": "#/$defs/metric"
        },
        "PERSISTENT_REGENERABLE_CACHE_BYTES": {
          "$ref": "#/$defs/metric"
        },
        "TOTAL_REQUIRED_PERMANENT_BYTES": {
          "$ref": "#/$defs/metric"
        },
        "TOTAL_OPTIONAL_CACHE_BYTES": {
          "$ref": "#/$defs/metric"
        },
        "PEAK_TRANSIENT_BYTES": {
          "$ref": "#/$defs/metric"
        },
        "PEAK_RSS": {
          "$ref": "#/$defs/metric"
        },
        "PEAK_SCRATCH_BYTES": {
          "$ref": "#/$defs/metric"
        },
        "MAX_SINGLE_TEMP_OBJECT_BYTES": {
          "$ref": "#/$defs/metric"
        },
        "UNAVOIDABLE_DECODED_FRAME_BYTES": {
          "$ref": "#/$defs/metric"
        },
        "RESIDUAL_SCRATCH_AFTER_SUCCESS_BYTES": {
          "$ref": "#/$defs/metric"
        },
        "RESIDUAL_SCRATCH_AFTER_FAILURE_BYTES": {
          "$ref": "#/$defs/metric"
        },
        "FIRST_BUILD_SECONDS": {
          "$ref": "#/$defs/metric"
        },
        "REPEAT_BUILD_SECONDS": {
          "$ref": "#/$defs/metric"
        },
        "I03_WORKLOAD_SECONDS": {
          "$ref": "#/$defs/metric"
        },
        "I05_PRIMITIVE_SECONDS": {
          "$ref": "#/$defs/metric"
        },
        "I05_DISCOVERY_PROGRAM_SECONDS": {
          "$ref": "#/$defs/metric"
        },
        "DISCOVERY_CANDIDATE_EVALUATIONS": {
          "$ref": "#/$defs/metric"
        },
        "SOURCE_OPEN_COUNT": {
          "$ref": "#/$defs/metric"
        },
        "DECODE_PASS_COUNT": {
          "$ref": "#/$defs/metric"
        },
        "VALIDATION_SECONDS": {
          "$ref": "#/$defs/metric"
        },
        "EMPIRICAL_MODEL_COMPILE_SECONDS": {
          "$ref": "#/$defs/metric"
        },
        "STRUCTURAL_COMPILE_FIXTURE_SECONDS": {
          "$ref": "#/$defs/metric"
        },
        "INFERENCE_LATENCY_SECONDS": {
          "$ref": "#/$defs/metric"
        },
        "ANALYTICAL_QUERY_LATENCY_SECONDS": {
          "$ref": "#/$defs/metric"
        },
        "AUDIT_REPLAY_SECONDS": {
          "$ref": "#/$defs/metric"
        },
        "CACHELESS_REBUILD_SECONDS": {
          "$ref": "#/$defs/metric"
        },
        "INCREMENTAL_REBUILD_SECONDS": {
          "$ref": "#/$defs/metric"
        },
        "MOVING_PART_COUNT": {
          "$ref": "#/$defs/metric"
        },
        "PERSISTENT_BYTES_REMOVABLE_WITH_ZERO_INFORMATION_LOSS": {
          "$ref": "#/$defs/metric"
        }
      }
    },
    "final_integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_validation_state",
        "validator_id",
        "evidence_bundle_ref"
      ],
      "properties": {
        "receipt_validation_state": {
          "$ref": "#/$defs/claim_state"
        },
        "validator_id": {
          "const": "rawlsing.dva.as4.terminal-evidence-receipt-validator/1.0.0"
        },
        "evidence_bundle_ref": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9_.:-]{2,127}$"
        }
      }
    }
  },
  "$defs": {
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9][A-Z0-9_.:-]{2,127}$"
      }
    },
    "authority_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_authority_id",
        "demand_ref",
        "reopen_condition"
      ],
      "properties": {
        "required_authority_id": {
          "type": "string",
          "minLength": 1
        },
        "demand_ref": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9_.:-]{2,127}$"
        },
        "reopen_condition": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "execution_failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failure_class",
        "phase",
        "evidence_refs"
      ],
      "properties": {
        "failure_class": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidence_refs"
        }
      }
    },
    "claim_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidence_refs"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED_MISSING_AUTHORITY",
            "EXECUTION_FAILED",
            "NOT_EXERCISED_BY_THIS_BENCHMARK",
            "NOT_APPLICABLE",
            "UNRESOLVED_GOVERNED_OBLIGATION"
          ]
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidence_refs"
        },
        "authority_gap": {
          "$ref": "#/$defs/authority_gap"
        },
        "execution_failure": {
          "$ref": "#/$defs/execution_failure"
        },
        "note": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "BLOCKED_MISSING_AUTHORITY"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "authority_gap"
            ],
            "not": {
              "required": [
                "execution_failure"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "EXECUTION_FAILED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "execution_failure"
            ],
            "not": {
              "required": [
                "authority_gap"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "NOT_EXERCISED_BY_THIS_BENCHMARK",
                  "NOT_APPLICABLE",
                  "UNRESOLVED_GOVERNED_OBLIGATION"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "authority_gap"
                  ]
                },
                {
                  "required": [
                    "execution_failure"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "exercise_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "exercised",
        "evidence_refs"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED_MISSING_AUTHORITY",
            "EXECUTION_FAILED",
            "NOT_EXERCISED_BY_THIS_BENCHMARK",
            "NOT_APPLICABLE"
          ]
        },
        "exercised": {
          "type": "boolean"
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidence_refs"
        },
        "authority_gap": {
          "$ref": "#/$defs/authority_gap"
        },
        "execution_failure": {
          "$ref": "#/$defs/execution_failure"
        },
        "note": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "EXECUTION_FAILED"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "exercised": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "NOT_EXERCISED_BY_THIS_BENCHMARK",
                  "BLOCKED_MISSING_AUTHORITY",
                  "NOT_APPLICABLE"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "exercised": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "BLOCKED_MISSING_AUTHORITY"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "authority_gap"
            ],
            "not": {
              "required": [
                "execution_failure"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "EXECUTION_FAILED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "execution_failure"
            ],
            "not": {
              "required": [
                "authority_gap"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "NOT_EXERCISED_BY_THIS_BENCHMARK",
                  "NOT_APPLICABLE"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "authority_gap"
                  ]
                },
                {
                  "required": [
                    "execution_failure"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "preservation_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidence_refs"
      ],
      "properties": {
        "status": {
          "enum": [
            "CURRENT_LIVE_AUTHORITY_PROVED",
            "CURRENT_LIVE_AUTHORITY_JURISDICTION_PROVED__POSITIVE_LOAD_UNPROVED",
            "PRESERVED_BY_EXACT_GOVERNED_REFERENCE_TO_FROZEN_AUTHORITY",
            "PRESERVED_BY_TYPED_LIFECYCLE/SUCCESSION_TO_CURRENT_AUTHORITY",
            "PRESERVED_AS_EXACT_UNRESOLVED/BLOCKED_AUTHORITY",
            "PRESERVED_AS_CONSTRAINT/NONINFERENCE_LAW",
            "PRESERVED_AS_PROVENANCE/REPLAY_REQUIRED_FOR_AUTHORITY_INTERPRETATION",
            "FUNCTION_PRESERVED__HISTORICAL_MECHANISM_COMPOSTABLE_AFTER_BROADER_RELEASE",
            "UNRESOLVED_AUTHORITY_PRESERVATION_GAP"
          ]
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidence_refs"
        },
        "reopen_condition": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "PRESERVED_AS_EXACT_UNRESOLVED/BLOCKED_AUTHORITY",
                  "UNRESOLVED_AUTHORITY_PRESERVATION_GAP"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "reopen_condition"
            ]
          }
        }
      ]
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "unit",
        "evidence_refs"
      ],
      "properties": {
        "status": {
          "enum": [
            "MEASURED",
            "NOT_APPLICABLE",
            "BLOCKED_MISSING_AUTHORITY",
            "NOT_EXERCISED_BY_THIS_BENCHMARK",
            "EXECUTION_FAILED"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle_scope": {
          "type": "string"
        },
        "invocation_frequency": {
          "type": "string"
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidence_refs"
        },
        "authority_gap": {
          "$ref": "#/$defs/authority_gap"
        },
        "execution_failure": {
          "$ref": "#/$defs/execution_failure"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "MEASURED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "NOT_APPLICABLE",
                  "BLOCKED_MISSING_AUTHORITY",
                  "NOT_EXERCISED_BY_THIS_BENCHMARK",
                  "EXECUTION_FAILED"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "BLOCKED_MISSING_AUTHORITY"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "authority_gap"
            ],
            "not": {
              "required": [
                "execution_failure"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "EXECUTION_FAILED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "execution_failure"
            ],
            "not": {
              "required": [
                "authority_gap"
              ]
            }
          }
        }
      ]
    },
    "evidence_object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "kind",
        "locator"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9_.:-]{2,127}$"
        },
        "kind": {
          "enum": [
            "REPO_ARTIFACT",
            "RUN_ARTIFACT",
            "AUTHORITY",
            "MANIFEST",
            "RECEIPT",
            "ORACLE",
            "SOURCE",
            "LOG",
            "OTHER"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "git_blob_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "git_commit_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "authority_ceiling": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "anyOf": [
        {
          "required": [
            "content_sha256"
          ]
        },
        {
          "required": [
            "git_blob_sha"
          ]
        },
        {
          "required": [
            "git_commit_sha"
          ]
        }
      ]
    },
    "authority_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_id",
        "role",
        "evidence_ref",
        "authority_ceiling"
      ],
      "properties": {
        "authority_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "SOURCE_SEMANTIC",
            "RAWLSING_SEMANTIC",
            "P10_PRESERVATION",
            "C11",
            "I03",
            "I05",
            "I04",
            "MEASUREMENT",
            "TERMINAL",
            "OTHER"
          ]
        },
        "evidence_ref": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9_.:-]{2,127}$"
        },
        "authority_ceiling": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "bfunc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "function_key",
        "governed_function",
        "preservation",
        "exercise",
        "consumer_disposition"
      ],
      "properties": {
        "function_key": {
          "type": "string",
          "minLength": 1
        },
        "governed_function": {
          "type": "string",
          "minLength": 1
        },
        "preservation": {
          "$ref": "#/$defs/preservation_state"
        },
        "exercise": {
          "$ref": "#/$defs/exercise_state"
        },
        "consumer_disposition": {
          "enum": [
            "DIRECT_REUSE",
            "PERSIST",
            "EXACT_DERIVATION",
            "MIXED",
            "UNRESOLVED_GOVERNED_OBLIGATION"
          ]
        }
      }
    },
    "nonpositive_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "subject_ref",
        "state_kind",
        "search_complete",
        "authorized_universe_ref",
        "completion_law_ref",
        "evidence_refs"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "subject_ref": {
          "type": "string",
          "minLength": 1
        },
        "state_kind": {
          "enum": [
            "PROVEN_NEGATIVE",
            "COMPLETE_AUTHORIZED_SEARCH__NO_RELATION_FOUND",
            "VALID_EMPTY",
            "PARTIAL_FRONTIER",
            "BUDGET_EXHAUSTED",
            "UNSUPPORTED_OR_NONCOMPARABLE_DOMAIN",
            "CANDIDATE_FOUND__VALIDATION_REJECTED",
            "BLOCKED_MISSING_AUTHORITY",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ]
        },
        "search_complete": {
          "type": "boolean"
        },
        "authorized_universe_ref": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9_.:-]{2,127}$"
        },
        "completion_law_ref": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9_.:-]{2,127}$"
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidence_refs"
        },
        "authority_gap": {
          "$ref": "#/$defs/authority_gap"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state_kind": {
                "enum": [
                  "PROVEN_NEGATIVE",
                  "COMPLETE_AUTHORIZED_SEARCH__NO_RELATION_FOUND"
                ]
              }
            },
            "required": [
              "state_kind"
            ]
          },
          "then": {
            "properties": {
              "search_complete": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state_kind": {
                "enum": [
                  "PARTIAL_FRONTIER",
                  "BUDGET_EXHAUSTED",
                  "BLOCKED_MISSING_AUTHORITY",
                  "UNKNOWN"
                ]
              }
            },
            "required": [
              "state_kind"
            ]
          },
          "then": {
            "properties": {
              "search_complete": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state_kind": {
                "const": "BLOCKED_MISSING_AUTHORITY"
              }
            },
            "required": [
              "state_kind"
            ]
          },
          "then": {
            "required": [
              "authority_gap"
            ]
          }
        }
      ]
    },
    "reuse_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terminal_capability",
        "disposition",
        "evidence_refs"
      ],
      "properties": {
        "terminal_capability": {
          "enum": [
            "NINE_STRATA_FIELD",
            "INTER_STRATA_PRESSURE_COUNTERPRESSURE",
            "RELATIONAL_SOURCE_TARGET_DIRECTION",
            "TEMPORAL_HISTORY_PERSISTENCE_DRIFT_RUPTURE_LIMITS",
            "CONTRADICTION_COEXISTING_PRESSURE",
            "MEDIATION",
            "BUFFERING_AMPLIFICATION_DEFLECTION_BLOCKAGE_REROUTING",
            "ORIENTATION_TO_STRATA",
            "ABSOLUTE_HORIZON",
            "STRUCTURAL_PRESSURE_FLOW_TOPOLOGY",
            "ATTRACTOR_PREREQUISITES_FORMATION",
            "ACTOR_DEVELOPMENTAL_CAUSALITY",
            "GENEALOGY_PARENT_PARTNER_CHILD_RECURSION",
            "V2_PHENOMENOLOGY_EXPRESSION",
            "EPISTEMIC_CLASS_PROVENANCE",
            "UNCERTAINTY_ABSENCE_NONCOMPARABILITY_FORBIDDEN_INFERENCE"
          ]
        },
        "disposition": {
          "enum": [
            "OWN_AND_DERIVE_HERE",
            "PRESERVE_BY_REFERENCE",
            "PROVIDE_PREREQUISITE_ONLY",
            "DIRECT_UPSTREAM_REUSE_SUFFICIENT",
            "DOWNSTREAM_OWNS",
            "MISSING_AUTHORITY",
            "IRRELEVANT_TO_THIS_STAGE"
          ]
        },
        "upstream_authority_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9_.:-]{2,127}$"
          }
        },
        "current_stage_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "downstream_owner_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidence_refs"
        }
      }
    },
    "persistent_category_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_class",
        "evidence_refs"
      ],
      "properties": {
        "authority_class": {
          "enum": [
            "PRIMARY_AUTHORITY",
            "GOVERNED_DERIVED_LEARNED_PRODUCT",
            "OPERATIONALLY_RETAINED_REGENERABLE_REPRESENTATION",
            "OPTIONAL_CACHE",
            "NOT_PRESENT"
          ]
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidence_refs"
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
