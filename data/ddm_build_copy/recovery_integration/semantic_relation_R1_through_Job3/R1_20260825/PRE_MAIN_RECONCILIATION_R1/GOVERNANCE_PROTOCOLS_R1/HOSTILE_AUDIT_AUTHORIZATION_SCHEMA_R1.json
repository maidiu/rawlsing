{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authorization_version",
    "authorization_role",
    "canonical_head",
    "candidate_sha",
    "expected_audit_branch",
    "audit_write_prefix",
    "challenge_nonce",
    "allowed_pass_rulings",
    "allowed_terminal_token_prefixes"
  ],
  "properties": {
    "authorization_version": {"const": "RAWLSING_HOSTILE_AUDIT_AUTHORIZATION_R1"},
    "authorization_role": {"const": "VOZHD_EXTERNAL_AUDIT_AUTHORIZATION"},
    "canonical_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "expected_audit_branch": {"type": "string", "minLength": 1},
    "audit_write_prefix": {"type": "string", "minLength": 1},
    "challenge_nonce": {"type": "string", "minLength": 16},
    "allowed_pass_rulings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "PASS__ENFORCEMENT_PREMAIN_INTEGRATION_READY",
          "PASS_WITH_BOUNDED_NONBLOCKING_FRICTION__ENFORCEMENT_PREMAIN_INTEGRATION_READY"
        ]
      }
    },
    "allowed_terminal_token_prefixes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 8}
    }
  }
}
