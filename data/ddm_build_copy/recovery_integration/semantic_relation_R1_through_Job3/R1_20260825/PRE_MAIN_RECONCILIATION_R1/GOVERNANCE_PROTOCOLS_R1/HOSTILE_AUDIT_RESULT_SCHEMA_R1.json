{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "audit_version",
    "audit_mode",
    "candidate_sha",
    "authorization_ref",
    "challenge_nonce",
    "audit_branch",
    "overall_ruling",
    "terminal_token"
  ],
  "properties": {
    "audit_version": {"const": "RAWLSING_HOSTILE_AUDIT_RESULT_R1"},
    "audit_mode": {"const": "HOSTILE_INDEPENDENT_AUDIT"},
    "candidate_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "authorization_ref": {"type": "string", "pattern": "^[0-9a-f]{40}:.+$"},
    "challenge_nonce": {"type": "string", "minLength": 16},
    "audit_branch": {"type": "string", "minLength": 1},
    "overall_ruling": {
      "enum": [
        "PASS__ENFORCEMENT_PREMAIN_INTEGRATION_READY",
        "PASS_WITH_BOUNDED_NONBLOCKING_FRICTION__ENFORCEMENT_PREMAIN_INTEGRATION_READY",
        "BLOCKED__ENFORCEMENT_NOT_INTEGRATION_READY"
      ]
    },
    "terminal_token": {"type": "string", "minLength": 8}
  }
}
