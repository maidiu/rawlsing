{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rawlsing Work Return R1",
  "type": "object",
  "additionalProperties": false,
  "required": ["work_unit_id","canonical_launch_head","agent_mode","local_status","result_ref","accomplished","not_accomplished","remaining_open","touched_obligation_dispositions","new_obligations","spawned_successors","return_to_ids","authority_obtained","authority_not_obtained","central_state_changed","central_state_unchanged","reintegration_status","required_next_reintegration_action"],
  "properties": {
    "work_unit_id":{"type":"string","minLength":1},
    "canonical_launch_head":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "agent_mode":{"type":"string"},
    "local_status":{"type":"string"},
    "result_ref":{"type":"string","minLength":1},
    "accomplished":{"type":"array","items":{"type":"string"}},
    "not_accomplished":{"type":"array","items":{"type":"string"}},
    "remaining_open":{"type":"array","items":{"type":"string"}},
    "touched_obligation_dispositions":{"type":"array","items":{"type":"object","required":["obligation_id","disposition"],"properties":{"obligation_id":{"type":"string"},"disposition":{"type":"string"}}}},
    "new_obligations":{"type":"array","items":{"type":"string"}},
    "spawned_successors":{"type":"array","items":{"type":"string"}},
    "return_to_ids":{"type":"array","items":{"type":"string"}},
    "authority_obtained":{"type":"array","items":{"type":"string"}},
    "authority_not_obtained":{"type":"array","items":{"type":"string"}},
    "central_state_changed":{"type":"array","items":{"type":"string"}},
    "central_state_unchanged":{"type":"array","items":{"type":"string"}},
    "reintegration_status":{"enum":["ACTIVE_GROUNDED","LOCAL_COMPLETE_UNRECONCILED","BLOCKED_ON_DEPENDENCY","SPAWNED_SUCCESSOR_RETURN_REQUIRED","CAMPAIGN_ACCEPTED_UNBANKED","HQ_BANKED_NOT_CANONICALLY_INHERITED","PRESERVED_NONCURRENT","DELIBERATELY_NOT_ADOPTED","CANONICALLY_INHERITED","SUPERSEDED_AT_EXACT_GRAIN","INTERRUPTED_STRANDED","UNKNOWN_REQUIRES_SYNTHESIS","EXPLORATORY_UNRECONCILED"]},
    "required_next_reintegration_action":{"type":"string","minLength":1}
  }
}
