{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rawlsing Central State Update Packet R1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["canonical_project_head","ground_version","grounding_receipt_id","authority_ceiling","return_destination","touched_state_ids","touched_obligation_ids","obligation_dispositions","new_obligations","successor_return_paths","reintegration_status","anti_resurrection_acknowledged"],
  "properties": {
    "canonical_project_head":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "ground_version":{"const":"RAWLSING_GROUND_R1"},
    "grounding_receipt_id":{"type":"string","minLength":1},
    "authority_ceiling":{"type":"string","minLength":1},
    "return_destination":{"type":"string","minLength":1},
    "touched_state_ids":{"type":"array","minItems":1,"items":{"type":"string"}},
    "touched_obligation_ids":{"type":"array","items":{"type":"string"}},
    "obligation_dispositions":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["obligation_id","status"],"properties":{"obligation_id":{"type":"string"},"status":{"enum":["OPEN","PARTIALLY_CLOSED","BLOCKED_ON_DEPENDENCY","SUSPENDED_ON_DEPENDENCY","SPAWNED_SUCCESSOR_RETURN_REQUIRED","INTERRUPTED_STRANDED","RETURN_REQUIRED","UNKNOWN_REQUIRES_SYNTHESIS","SUPERSEDED_AT_GRAIN_WITH_SURVIVING_OBLIGATION","ABANDONED_BY_EXPLICIT_DECISION","CLOSED"]}}}},
    "new_obligations":{"type":"array","items":{"type":"string"}},
    "successor_return_paths":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["successor_id","parent_obligation_id","return_to"],"properties":{"successor_id":{"type":"string","minLength":1},"parent_obligation_id":{"type":"string","pattern":"^OBL[0-9]{3}$"},"return_to":{"type":"string","minLength":1}}}},
    "reintegration_status":{"enum":["ACTIVE_GROUNDED","LOCAL_COMPLETE_UNRECONCILED","BLOCKED_ON_DEPENDENCY","SPAWNED_SUCCESSOR_RETURN_REQUIRED","CAMPAIGN_ACCEPTED_UNBANKED","HQ_BANKED_NOT_CANONICALLY_INHERITED","PRESERVED_NONCURRENT","DELIBERATELY_NOT_ADOPTED","CANONICALLY_INHERITED","SUPERSEDED_AT_EXACT_GRAIN","INTERRUPTED_STRANDED","UNKNOWN_REQUIRES_SYNTHESIS","EXPLORATORY_UNRECONCILED"]},
    "anti_resurrection_acknowledged":{"const":true}
  }
}
