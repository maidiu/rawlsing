{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rawlsing Grounding Receipt R1",
  "type": "object",
  "additionalProperties": false,
  "required": ["grounding_receipt_id","agent_role","agent_mode","canonical_project_head","ground_version","task_scope","relevant_state_ids","relevant_obligation_ids","binding_authority_surfaces_read","must_factor_surfaces_read","anti_resurrection_constraints","authority_ceiling","may_decide","may_not_decide","dependencies","required_return_destination","central_state_head_match","grounding_complete_for_declared_scope"],
  "properties": {
    "grounding_receipt_id": {"type":"string","minLength":1},
    "agent_role": {"type":"string","minLength":1},
    "agent_mode": {"enum":["GROUNDED_PROJECT_DECISION","GROUNDED_BOUNDED_EXECUTION","FORENSIC_READ_ONLY","DELIBERATELY_UNGROUNDED_EXPLORATION","HOSTILE_INDEPENDENT_AUDIT"]},
    "canonical_project_head": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "ground_version": {"const":"RAWLSING_GROUND_R1"},
    "task_scope": {"type":"string","minLength":1},
    "relevant_state_ids": {"type":"array","items":{"type":"string"}},
    "relevant_obligation_ids": {"type":"array","items":{"type":"string"}},
    "relevant_tension_ids": {"type":"array","items":{"type":"string"},"default":[]},
    "relevant_unknown_ids": {"type":"array","items":{"type":"string"},"default":[]},
    "binding_authority_surfaces_read": {"type":"array","minItems":1,"items":{"type":"string"}},
    "must_factor_surfaces_read": {"type":"array","minItems":1,"items":{"type":"string"}},
    "anti_resurrection_constraints": {"type":"array","minItems":1,"items":{"type":"string"}},
    "authority_ceiling": {"type":"string","minLength":1},
    "may_decide": {"type":"array","items":{"type":"string"}},
    "may_not_decide": {"type":"array","items":{"type":"string"}},
    "dependencies": {"type":"array","items":{"type":"string"}},
    "required_return_destination": {"type":"string","minLength":1},
    "central_state_head_match": {"const":"PASS"},
    "grounding_complete_for_declared_scope": {"const":"PASS"}
  }
}
