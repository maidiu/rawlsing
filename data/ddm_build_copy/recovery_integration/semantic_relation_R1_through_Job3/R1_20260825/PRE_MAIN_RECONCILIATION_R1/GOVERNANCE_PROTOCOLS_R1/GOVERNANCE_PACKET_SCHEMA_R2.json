{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rawlsing Governance Packet R2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_version",
    "requested_effect",
    "decision_domain",
    "grounding_receipt",
    "work_return",
    "central_state_update",
    "scope_exclusions",
    "bounded_parent",
    "authority_effects",
    "closure_claims"
  ],
  "properties": {
    "packet_version": {"const": "RAWLSING_GOVERNANCE_PACKET_R2"},
    "requested_effect": {"enum": ["PROJECT_ADOPTION","CAMPAIGN_ACCEPTANCE","HQ_BANKING","GLOBAL_ADOPTION","PROJECT_CLOSURE_AT_GRAIN","BOUNDED_EXECUTION_RETURN","FORENSIC_RETURN","EXPLORATORY_RETURN"]},
    "decision_domain": {"enum": ["PHYSICAL_ARCHITECTURE","FIELD_FORGE","J01B","DVA_IMPLEMENTATION","PHYSICAL_PERSISTENCE","GLOBAL_ADOPTION","GENERAL_PROJECT_DECISION","CUSTOM"]},
    "grounding_receipt": {"type": "object"},
    "work_return": {"type": "object"},
    "central_state_update": {"type": "object"},
    "scope_exclusions": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["obligation_id","reason","preserved_open"],"properties":{"obligation_id":{"type":"string"},"reason":{"type":"string","minLength":1},"preserved_open":{"const":true}}}},
    "bounded_parent": {"type":"object","additionalProperties":false,"properties":{"parent_receipt_path":{"type":"string","minLength":1},"parent_receipt_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"parent_grounding_receipt_id":{"type":"string","minLength":1},"governing_adjudication_ref":{"type":"string","minLength":1},"forbidden_reinterpretation":{"type":"array","items":{"type":"string"}}}},
    "authority_effects": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["target_id","requested_effect","supporting_authority_ref","applicable_gate_ids"],"properties":{"target_id":{"type":"string","minLength":1},"requested_effect":{"type":"string","minLength":1},"supporting_authority_ref":{"type":"string","minLength":1},"applicable_gate_ids":{"type":"array","items":{"type":"string"}}}}},
    "closure_claims": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["obligation_id","closure_authority","supporting_evidence_ref","closure_condition_addressed"],"properties":{"obligation_id":{"type":"string"},"closure_authority":{"type":"string","minLength":1},"supporting_evidence_ref":{"type":"string","minLength":1},"closure_condition_addressed":{"type":"string","minLength":1}}}}
  }
}
