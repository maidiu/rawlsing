elta)}


def z_key_id(z: Tuple[str, str, str]) -> str:
    return "sha256:" + hashlib.sha256(canonical_json_bytes(list(z))).hexdigest()


def build_roster(respondents: Sequence[Respondent]) -> Tuple[List[Dict[str, object]], Dict[Tuple[str, str, str], List[Respondent]]]:
    groups: Dict[Tuple[str, str, str], List[Respondent]] = defaultdict(list)
    for r in respondents:
        groups[r.z_key].append(r)
    roster = []
    for z in sorted(groups):
        rows = groups[z]
        n0 = sum(r.c == C0 for r in rows)
        n1 = sum(r.c == C1 for r in rows)
        roster.append({
            "z_predicate_id": z_key_id(z), "Q70B_state_identity": z[0], "Q70C_state_identity": z[1], "Q84_state_identity": z[2],
            "observed_r_count": len(rows), "n_c0": n0, "n_c1": n1,
            "support_state": "ADMITTED_FOR_EXACT_QUERY" if n0 > 0 and n1 > 0 else "ABSTAIN__ZERO_DENOMINATOR__DO_NOT_FABRICATE",
        })
    return roster, groups


def classify_state(broad_sign: int, q: Mapping[str, object]) -> str:
    if not q["defined"]:
        return "ABSTAIN__ZERO_DENOMINATOR__DO_NOT_FABRICATE"
    s = int(q["sign"])
    if s == 0:
        return "EXACT_ZERO_DIFFERENCE_IN_REALIZED_SAMPLE"
    if broad_sign == 0:
        return "ABSTAIN__BROAD_ZERO__NO_BROAD_RELATIVE_REVERSAL_OR_PERSISTENCE"
    if s == -broad_sign:
        return "EXACT_DIRECTIONAL_REVERSAL"
    if s == broad_sign:
        return "EXACT_DIRECTIONAL_PERSISTENCE"
    raise AssertionError("unreachable sign state")


def compute_canonical(respondents: Sequence[Respondent]) -> Dict[str, object]:
    broad = compute_counts(respondents)
    if not broad["defined"]:
        broad_sign = 0
    else:
        broad_sign = int(broad["sign"])
    roster, groups = build_roster(respondents)
    within = []
    for rr in roster:
        z = (rr["Q70B_state_identity"], rr["Q70C_state_identity"], rr["Q84_state_identity"])
        q = compute_counts(groups[z])
        status = classify_state(broad_sign, q)
        rec = dict(rr)
        rec.update({"query": q, "directional_status": status})
        within.append(rec)
    admitted = [x for x in within if x["query"]["defined"]]
    signs = [int(x["query"]["sign"]) for x in admitted]
    statuses = Counter(x["directional_status"] for x in within)
    split = "EXACT_DIRECTIONAL_SPLIT" if (1 in signs and -1 in signs) else "NO_EXACT_DIRECTIONAL_SPLIT"
    if broad_sign == 0:
        reversal_present = "ABSTAIN__BROAD_ZERO__REVERSAL_PRESENT_NOT_DEFINED"
        persistence_all = "ABSTAIN__BROAD_ZERO__PERSISTENCE_ACROSS_NOT_DEFINED"
    else:
        reversal_present = "EXACT_DIRECTIONAL_REVERSAL_PRESENT" if any(s == -broad_sign for s in signs) else "NO_EXACT_DIRECTIONAL_REVERSAL_PRESENT"
        persistence_all = ("EXACT_DIRECTIONAL_PERSISTENCE_ACROSS_ADMITTED_STATES"
                           if signs and all(s == broad_sign and s != 0 for s in signs)
                           else "NO_EXACT_DIRECTIONAL_PERSISTENCE_ACROSS_ADMITTED_STATES")
    compound = {
        "broad_sign": broad_sign,
        "split": split,
        "reversal_present": reversal_present,
        "persistence_across_admitted_states": persistence_all,
        "roster_observed_states": len(roster),
        "admitted_states": len(admitted),
        "abstaining_states": len(roster) - len(admitted),
        "state_sign_positive": sum(s == 1 for s in signs),
        "state_sign_negative": sum(s == -1 for s in signs),
        "state_sign_zero": sum(s == 0 for s in signs),
        "status_counts": dict(sorted(statuses.items())),
    }
    return {"broad": broad, "roster": roster, "within": within, "compound": compound, "groups": groups}


def delete_one_for_context(context_id: str, rows: Sequence[Respondent], original: Mapping[str, object]) -> Tuple[List[Dict[str, object]], Dict[str, object]]:
    if not original["defined"]:
        raise FailClosed(f"DELETE_ONE_CALLED_ON_UNDEFINED_ORIGINAL::{context_id}")
    n0, n1 = int(original["n_c0"]), int(original["n_c1"])
    y0, y1 = int(original["event_c0"]), int(original["event_c1"])
    osign = int(original["sign"])
    witnesses = []
    any_fragile = False
    any_undef = False
    relevant = [r for r in rows if r.c in (C0, C1)]
    for r in sorted(relevant, key=lambda x: x.key):
        pn0, pn1, py0, py1 = n0, n1, y0, y1
        if r.c == C0:
            pn0 -= 1; py0 -= r.event
        else:
            pn1 -= 1; py1 -= r.event
        if pn0 == 0 or pn1 == 0:
            defined = False; psign = ""; pdelta = ""; any_undef = True
            witness_state = "DELETE_ONE_UNDEFINED__ZERO_DENOMINATOR_AFTER_DELETION"
            sign_changed = False
        else:
            defined = True
            d = Fraction(py1, pn1) - Fraction(py0, pn0)
            psign = sign_of_fraction(d)
            pdelta = f"{d.numerator}/{d.denominator}"
            sign_changed = psign != osign
            if sign_changed: any_fragile = True
            witness_state = "DELETE_ONE_DEFINED__SIGN_CHANGED" if sign_changed else "DELETE_ONE_DEFINED__SIGN_PRESERVED"
        witnesses.append({
            "query_context_id": context_id, "COUNTRY": r.country, "RESPNO": r.respno, "respondent_local_id": r.local_id,
            "deleted_c_arm": r.c, "deleted_event_membership": r.event,
            "pre_n_c0": n0, "pre_event_c0": y0, "pre_n_c1": n1, "pre_event_c1": y1, "pre_sign": osign,
            "post_n_c0": pn0, "post_event_c0": py0, "post_n_c1": pn1, "post_event_c1": py1,
            "post_defined": "TRUE" if defined else "FALSE", "post_delta_exact": pdelta, "post_sign": psign,
            "witness_state": witness_state,
        })
    classes = []
    if any_fragile:
        classes.append("DELETE_ONE_DIRECTION_FRAGILE")
    elif not any_undef:
        classes.append("DELETE_ONE_DIRECTION_STABLE")
    if any_undef:
        classes.append("DELETE_ONE_NOT_FULLY_EVALUABLE__ZERO_DENOMINATOR_AFTER_DELETION")
    summary = {"query_context_id": context_id, "original_sign": osign, "witness_count": len(witnesses), "classifications": classes,
               "direction_fragile": any_fragile, "not_fully_evaluable": any_undef}
    return witnesses, summary


def slot_views(canonical: Mapping[str, object]) -> Dict[str, object]:
    # Normalized AS01-AS07 truth objects. These are the only objects used for challenger equality.
    roster = canonical["roster"]
    within = canonical["within"]
    return {
        "AS01": canonical["broad"],
        "AS02": [{k: r[k] for k in ("z_predicate_id", "Q70B_state_identity", "Q70C_state_identity", "Q84_state_identity", "observed_r_count")} for r in roster],
        "AS03": [{k: r[k] for k in ("z_predicate_id", "n_c0", "n_c1", "support_state")} for r in roster],
        "AS04": [{"z_predicate_id": r["z_predicate_id"], "query": r["query"]} for r in within],
        "AS05": [{"z_predicate_id": r["z_predicate_id"], "directional_status": r["directional_status"], "sign": r["query"].get("sign", "")} for r in within],
        "AS06": canonical["compound"],
        "AS07": [{"z_p