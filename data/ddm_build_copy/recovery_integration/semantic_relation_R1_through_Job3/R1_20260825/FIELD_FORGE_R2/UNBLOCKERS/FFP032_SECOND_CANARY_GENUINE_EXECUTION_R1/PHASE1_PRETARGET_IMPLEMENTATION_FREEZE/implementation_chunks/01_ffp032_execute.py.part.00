class FailClosed(RuntimeError):
    pass


def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def canonical_json_bytes(obj: object) -> bytes:
    return json.dumps(obj, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8")


def sha256_obj(obj: object) -> str:
    return hashlib.sha256(canonical_json_bytes(obj)).hexdigest()


def write_json(path: Path, obj: object) -> None:
    path.write_bytes(canonical_json_bytes(obj))


def write_tsv(path: Path, fieldnames: Sequence[str], rows: Iterable[Mapping[str, object]]) -> None:
    with path.open("w", encoding="utf-8", newline="") as f:
        w = csv.DictWriter(f, fieldnames=fieldnames, delimiter="\t", lineterminator="\n", extrasaction="raise")
        w.writeheader()
        for row in rows:
            w.writerow({k: row.get(k, "") for k in fieldnames})


def write_tsv_gz_deterministic(path: Path, fieldnames: Sequence[str], rows: Iterable[Mapping[str, object]]) -> None:
    with path.open("wb") as raw:
        with gzip.GzipFile(filename="", mode="wb", fileobj=raw, mtime=0) as gz:
            with io.TextIOWrapper(gz, encoding="utf-8", newline="") as text:
                w = csv.DictWriter(text, fieldnames=fieldnames, delimiter="\t", lineterminator="\n", extrasaction="raise")
                w.writeheader()
                for row in rows:
                    w.writerow({k: row.get(k, "") for k in fieldnames})


def read_tsv_gz(path: Path, expected_header: Sequence[str]) -> Iterable[Dict[str, str]]:
    with gzip.open(path, "rt", encoding="utf-8", newline="") as f:
        r = csv.DictReader(f, delimiter="\t")
        if r.fieldnames != list(expected_header):
            raise FailClosed(f"HEADER_MISMATCH::{path.name}::{r.fieldnames!r}")
        for row in r:
            yield row


def parse_native_int(value: str) -> int:
    # Physical lexical normalization only: integer-valued source codes may serialize as 1 or 1.0.
    if re.fullmatch(r"-?\d+", value):
        return int(value)
    if re.fullmatch(r"-?\d+\.0+", value):
        return int(value.split(".", 1)[0])
    raise FailClosed(f"NON_INTEGER_NATIVE_STATE::{value!r}")


@dataclass(frozen=True)
class Respondent:
    country: str
    respno: str
    local_id: str
    country_alpha3: str
    state_identity: Mapping[str, str]
    source_state: Mapping[str, int]

    @property
    def key(self) -> Tuple[str, str]:
        return (self.country, self.respno)

    @property
    def c(self) -> int:
        return self.source_state[C_VAR]

    @property
    def event(self) -> int:
        return 1 if self.source_state[D_VAR] == EVENT_STATE else 0

    @property
    def z_key(self) -> Tuple[str, str, str]:
        return tuple(self.state_identity[z] for z in Z_VARS)  # exact opaque state identities


