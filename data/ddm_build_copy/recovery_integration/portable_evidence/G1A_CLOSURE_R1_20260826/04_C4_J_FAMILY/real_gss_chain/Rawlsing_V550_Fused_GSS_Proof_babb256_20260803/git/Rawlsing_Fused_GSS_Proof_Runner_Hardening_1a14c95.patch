+def runtime_pythonpath(repo_root: Path) -> str:
+    return str((repo_root / "35_V552J_COMPONENT_AWARE_STRATA_HORIZON_RUNTIME_BRIDGE" / "runtime_reproducibility_code").resolve())
+
+
+def command_for_report(command: list[str]) -> list[str]:
+    out: list[str] = []
+    redact_next = False
+    for item in command:
+        if redact_next:
+            out.append(redact_db_url(item))
+            redact_next = False
+            continue
+        out.append(item)
+        if item == "--db-url":
+            redact_next = True
+    return out
+
+
+def redact_db_url(value: str) -> str:
+    try:
+        parsed = urlsplit(value)
+    except Exception:
+        return "***"
+    if not parsed.scheme or not parsed.netloc:
+        return "***"
+    host = parsed.hostname or ""
+    port = f":{parsed.port}" if parsed.port else ""
+    netloc = f"***@{host}{port}" if parsed.username or parsed.password else parsed.netloc
+    return urlunsplit((parsed.scheme, netloc, parsed.path, parsed.query, parsed.fragment))
+
+
