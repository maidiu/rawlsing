{
  "schema_id": "PRE553_SOURCE_TO_C11_POPULATED_EVIDENCE_REQUIREMENTS",
  "version": "1.0.0",
  "assignment_id": "PRE553-W01-P05-001",
  "evidence_scope": "ONE_EXACT_SOURCE_RELEASE_UNIVERSE_PER_RECEIPT",
  "required_identity": {
    "git_head": true,
    "clean_worktree_before": true,
    "clean_worktree_after": true,
    "source_raw_id": true,
    "source_release_or_instrument_id": true,
    "raw_wave_id": true,
    "canonical_wave_id": true,
    "country_or_geography_id": true,
    "sample_or_empirical_universe_id": true,
    "source_snapshot_manifest_hash": true,
    "c11_empirical_universe_id": true,
    "c11_semantic_content_identity": true,
    "protocol_id_version_hash": true
  },
  "required_authorities": [
    "source-native semantic/codebook authority",
    "question/component identity authority",
    "response-topology authority",
    "routing/skip/applicability authority",
    "risk-set/query authority",
    "weight design/basis/estimand authority",
    "coordinate normalization/crosswalk authority",
    "C11 ingest authority",
    "empirical query/replay authority",
    "branch/discovery authority where applicable",
    "source-universe relation/overlap/linkage authority where applicable",
    "structural-admission provenance authority where frontier fixture requires it"
  ],
  "source_native_inventory": {
    "source_file_or_object_ids_and_hashes": true,
    "respondent_identity_set_hash_and_count": true,
    "question_component_identity_manifest_hash": true,
    "response_event_count_by_topology_and_typed_state": true,
    "event_group_event_id_event_index_coverage": true,
    "routing_applicability_count_by_typed_state": true,
    "risk_set_fixture_member_set_hashes": true,
    "typed_missing_dk_refusal_iap_not_asked_inapplicable_counts": true,
    "weight_value_status_basis_inventory": true,
    "native_coordinate_identity_value_unit_taxonomy_time_inventory": true,
    "branch_and_joint_configuration_inventory_where_applicable": true
  },
  "c11_inventory": {
    "respondent_identity_set_hash_and_count": true,
    "respondent_event_count_by_topology_and_typed_state": true,
    "empirical_coordinate_fact_inventory": true,
    "routing_eligibility_inventory_or_exact_rule_refs": true,
    "weight_measure_fact_inventory": true,
    "authority_snapshot_manifest_hash": true,
    "source_relation_overlap_linkage_refs_where_applicable": true,
    "semantic_integrity_manifest_hash": true,
    "replay_manifest_hash": true,
    "rejected_count": true,
    "defaulted_count": true,
    "coerced_count": true,
    "certified_requires_unauthorized_defaulted_count": 0,
    "certified_requires_unauthorized_coerced_count": 0
  },
  "d13b_p01_p20_evidence": {
    "required_for_each_dimension": [
      "proof_id",
      "applicability_state_and_authority",
      "source_object_ref_hash",
      "replay_object_ref_hash",
      "comparison_key_hash",
      "expected_equality",
      "allowed_normalization_authority_ref_hash_or_none",
      "source_diagnostic_hash",
      "replay_diagnostic_hash",
      "state_PASS_FAIL_BLOCKED_NOT_APPLICABLE",
      "mismatch_or_blocker_detail",
      "evidence_bundle_refs_hashes"
    ],
    "certified_requires_all_mandatory_applicable_pass": true,
    "certified_allows_mandatory_fail": false,
    "certified_allows_mandatory_blocked": false
  },
  "d13_m01_m18_evidence": {
    "required": true,
    "proof_rule": "EVERY_FRONTIER_REQUIRED_INFORMATION_CLASS_PRESENT_OR_EXACTLY_IMMUTABLY_DEREFERENCEABLE",
    "minimum_classes": [
      "empirical universe/source/release/instrument identity",
      "scoped respondent identity",
      "respondent-bound response-event incidence",
      "native and canonical question/component identity",
      "raw/source-native and canonical response value",
      "event group/event/index identity",
      "scalar/set/repeat/rank/order topology",
      "routing/applicability/risk-set semantics",
      "typed absence and non-substantive states",
      "respondent-bound empirical-coordinate incidence",
      "native/canonical coordinate identity and values",
      "units/taxonomy/effective or reference time",
      "normalization/crosswalk authority",
      "weight facts and design/estimand/basis authority",
      "source-native semantic authority",
      "source-universe relation/overlap/linkage authority where applicable",
      "branch/discovery/structural-admission/replay provenance required by frontier",
      "deterministic semantic replay closure"
    ]
  },
  "d12_d13_t01_t18_evidence": {
    "required": true,
    "frontier_classes": [
      "unary distribution",
      "single-coordinate conditional",
      "multi-coordinate conjunction",
      "response-coordinate conjunction",
      "response-response pair joint",
      "bounded k-way parity/XOR or equivalent hostile joint fixture",
      "minority or rare configuration",
      "branch membership",
      "branch cotravel",
      "routing and typed absence",
      "multiplicity/topology",
      "temporal/raw-wave distinction",
      "source-universe disagreement without silent pooling",
      "overlap/double-counting provenance where applicable",
      "actor-comparator source predicate replay where applicable",
      "reverse possibility-field empirical query support where applicable",
      "structural-admission empirical provenance where applicable",
      "autonomous-discovery replay over declared frontier"
    ],
    "required_per_fixture": [
      "fixture_id",
      "authority_refs_hashes",
      "source_query_or_native_evaluation_identity",
      "c11_query_identity",
      "risk_set_member_hash",
      "target_identity",
      "raw_result",
      "weighted_result_or_typed_blocked_state",
      "typed_absence_state",
      "source_result_hash",
      "c11_result_hash",
      "state",
      "exact_mismatch_or_blocker"
    ]
  },
  "determinism_evidence": {
    "minimum_identical_governed_runs": 2,
    "must_match": [
      "canonical semantic proof inputs",
      "P01-P20 states and evidence identities",
      "M01-M18 states",
      "T01-T18/frontier results",
      "logical semantic projection hash",
      "terminal certification state"
    ],
    "unordered_collection_permutation_test_required": true,
    "explicit_rank_sequence_must_remain_semantic": true
  },
  "validation_output": {
    "exact_commands": true,
    "stdout_or_report_hashes": true,
    "stderr_hashes_when_nonempty": true,
    "exit_statuses": true,
    "pytest_or_validation_summary": true,
    "code_config_fixture_hashes": true
  },
  "receipt_terminal_fields": [
    "certification_state",
    "failed_dimension_ids",
    "blocked_dimension_ids",
    "not_applicable_dimension_ids_with_authority",
    "unauthorized_defaulted_count",
    "unauthorized_coerced_count",
    "logical_semantic_projection_hash",
    "replay_root",
    "source_snapshot_retention_proof"
  ],
  "terminal_state_rule": {
    "FAILED": "ANY_MANDATORY_OBSERVED_SEMANTIC_MISMATCH",
    "BLOCKED": "NO_OBSERVED_MISMATCH_AND_ANY_MANDATORY_PROOF_UNRESOLVED",
    "CERTIFIED": "ALL_MANDATORY_APPLICABLE_PROOFS_PASS"
  },
  "non_certifying_evidence": [
    "schema parity alone",
    "row count parity alone",
    "aggregate parity alone",
    "selected-query parity alone",
    "serialized file hash alone",
    "schema hash alone",
    "canonical label equality alone"
  ],
  "source_snapshot_retention_required_for_all_terminal_states": true,
  "source_retirement_authorized": false,
  "runtime_or_contract_repair_during_run_authorized": false
}
