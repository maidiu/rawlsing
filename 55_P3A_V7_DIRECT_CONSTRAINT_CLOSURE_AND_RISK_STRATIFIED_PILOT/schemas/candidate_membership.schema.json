{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rawlsing.local/schemas/p3/v7/candidate_membership.schema.json",
  "title": "candidate_membership",
  "type": "object",
  "required": [
    "candidate_revision_id",
    "member_object_id",
    "membership_role",
    "membership_basis",
    "authority_release_id"
  ],
  "properties": {
    "candidate_revision_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^P3CANDREV-[0-9]{6}-R[0-9]{4}$"
    },
    "member_object_id": {
      "type": "string",
      "minLength": 1
    },
    "membership_role": {
      "enum": [
        "PROPOSED_MEMBER",
        "PROPOSED_HIERARCHICAL_CONTEXT"
      ]
    },
    "membership_basis": {
      "enum": [
        "COMPONENT_MEMBER",
        "ATTACHMENT_PROJECTION",
        "DIRECT_DIAGNOSTIC",
        "HIERARCHICAL_CONTEXT"
      ]
    },
    "authority_release_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^P3-AUTHORITY-[0-9]{4}-[0-9]{2}-[0-9]{2}-R[0-9]+$"
    }
  },
  "additionalProperties": false
}
