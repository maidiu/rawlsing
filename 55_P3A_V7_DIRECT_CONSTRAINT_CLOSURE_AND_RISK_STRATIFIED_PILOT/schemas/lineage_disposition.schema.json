{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rawlsing.local/schemas/p3/v7/lineage_disposition.schema.json",
  "title": "lineage_disposition",
  "type": "object",
  "required": [
    "subject_id",
    "subject_type",
    "disposition_status",
    "reason",
    "evidence_ids",
    "authority_release_id"
  ],
  "properties": {
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_type": {
      "enum": [
        "IMPORTED_SOURCE_LOCAL_LINEAGE",
        "LINEAGE_SEGMENT"
      ]
    },
    "disposition_status": {
      "enum": [
        "ADMINISTRATIVE_METADATA_PRESERVED",
        "BLOCKED_UNRESOLVED",
        "CANDIDATE_PARTICIPANT",
        "CANONICAL_MEMBER",
        "CONSTRAINT_ONLY_PRESERVED",
        "DERIVED_OR_INDEX_PRESERVED",
        "OUT_OF_SCOPE_NONQUESTION",
        "SOURCE_LOCAL_SINGLETON_PRESERVED",
        "SUPERSEDED_BY_SEGMENT",
        "UNADJUDICATED"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "canonical_family_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^JFAM-[0-9]{6}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "authority_release_id": {
      "type": "string",
      "pattern": "^P3-AUTHORITY-[0-9]{4}-[0-9]{2}-[0-9]{2}-R[0-9]+$"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "disposition_status": {
            "const": "CANONICAL_MEMBER"
          }
        },
        "required": [
          "disposition_status"
        ]
      },
      "then": {
        "required": [
          "canonical_family_id"
        ],
        "properties": {
          "canonical_family_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^JFAM-[0-9]{6}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "disposition_status": {
            "not": {
              "const": "CANONICAL_MEMBER"
            }
          }
        },
        "required": [
          "disposition_status"
        ]
      },
      "then": {
        "properties": {
          "canonical_family_id": {
            "type": "null"
          }
        }
      }
    }
  ]
}
