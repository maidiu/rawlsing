{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rawlsing.local/schemas/p3/v6/canonical_family.schema.json",
  "title": "canonical_family",
  "type": "object",
  "required": [
    "canonical_family_id",
    "created_by_adjudication_id",
    "created_release_id"
  ],
  "properties": {
    "canonical_family_id": {
      "type": "string",
      "pattern": "^JFAM-[0-9]{6}$"
    },
    "created_by_adjudication_id": {
      "type": "string",
      "pattern": "^P3ADJ-[0-9]{6}$"
    },
    "created_release_id": {
      "type": "string",
      "pattern": "^P3-AUTHORITY-[0-9]{4}-[0-9]{2}-[0-9]{2}-R[0-9]+$"
    },
    "retired_release_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^P3-AUTHORITY-[0-9]{4}-[0-9]{2}-[0-9]{2}-R[0-9]+$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false
}
