{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rawlsing.local/schemas/p3/v6/imported_lineage_membership.schema.json",
  "title": "imported_lineage_membership",
  "type": "object",
  "required": [
    "lineage_id",
    "implementation_id",
    "ordinal_position",
    "source_authority_id",
    "authority_release_id"
  ],
  "properties": {
    "lineage_id": {
      "type": "string",
      "minLength": 1
    },
    "implementation_id": {
      "type": "string",
      "minLength": 1
    },
    "ordinal_position": {
      "type": "integer",
      "minimum": 0
    },
    "source_authority_id": {
      "type": "string",
      "minLength": 1
    },
    "authority_release_id": {
      "type": "string",
      "pattern": "^P3-AUTHORITY-[0-9]{4}-[0-9]{2}-[0-9]{2}-R[0-9]+$"
    }
  },
  "additionalProperties": false
}
