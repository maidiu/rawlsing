{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rawlsing.local/schemas/p3/v6/attachment_review_group.schema.json",
  "title": "attachment_review_group",
  "type": "object",
  "required": [
    "group_id",
    "meta_node_ids",
    "projection_ids",
    "member_subject_ids",
    "origin_key",
    "authority_release_id"
  ],
  "properties": {
    "group_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^P3AR-[0-9a-f]{16}$"
    },
    "meta_node_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 2
    },
    "projection_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^P3PROJ-[0-9a-f]{16}$"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "member_subject_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 2
    },
    "origin_key": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
    },
    "authority_release_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^P3-AUTHORITY-[0-9]{4}-[0-9]{2}-[0-9]{2}-R[0-9]+$"
    }
  },
  "additionalProperties": false
}
