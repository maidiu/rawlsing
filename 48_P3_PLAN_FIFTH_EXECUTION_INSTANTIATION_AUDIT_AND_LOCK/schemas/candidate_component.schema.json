{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rawlsing.local/schemas/p3/v6/candidate_component.schema.json",
  "title": "candidate_component",
  "type": "object",
  "required": [
    "component_id",
    "component_type",
    "member_ids",
    "connectivity_projection_ids",
    "build_rule_version",
    "content_hash",
    "authority_release_id"
  ],
  "properties": {
    "component_id": {
      "type": "string",
      "pattern": "^P3COMP-[0-9a-f]{16}$"
    },
    "member_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 2
    },
    "build_rule_version": {
      "type": "string",
      "minLength": 1
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authority_release_id": {
      "type": "string",
      "pattern": "^P3-AUTHORITY-[0-9]{4}-[0-9]{2}-[0-9]{2}-R[0-9]+$"
    },
    "component_type": {
      "enum": [
        "STRICT_RESPONSE_COMPONENT",
        "PROPOSITION_ONLY_COMPONENT"
      ]
    },
    "connectivity_projection_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^P3PROJ-[0-9a-f]{16}$"
      },
      "uniqueItems": true,
      "minItems": 1
    }
  },
  "additionalProperties": false
}
