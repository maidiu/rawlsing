{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rawlsing.local/schemas/p3/v3/split_point.schema.json",
  "title": "split_point",
  "type": "object",
  "required": [
    "dimension",
    "left_member_ids",
    "right_member_ids",
    "rationale"
  ],
  "properties": {
    "dimension": {
      "type": "string",
      "minLength": 1
    },
    "left_member_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "right_member_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
