{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rawlsing.local/schemas/p3/v7/adjudication_decision.schema.json",
  "title": "adjudication_decision",
  "type": "object",
  "required": [
    "adjudication_id",
    "candidate_family_id",
    "candidate_revision_id",
    "decision_ordinal",
    "accepted_members",
    "excluded_members",
    "variant_assignments",
    "split_points",
    "hierarchical_relations",
    "collision_dispositions",
    "unresolved_boundaries",
    "response_portability_status",
    "evidence_bundle_hash",
    "authority_release_id",
    "decision_status",
    "rationale",
    "created_at",
    "split_results",
    "variant_promotions",
    "exclusion_promotions"
  ],
  "properties": {
    "adjudication_id": {
      "type": "string",
      "pattern": "^P3ADJ-[0-9]{6}$"
    },
    "candidate_family_id": {
      "type": "string",
      "pattern": "^P3CAND-[0-9]{6}$"
    },
    "candidate_revision_id": {
      "type": "string",
      "pattern": "^P3CANDREV-[0-9]{6}-R[0-9]{4}$"
    },
    "decision_status": {
      "enum": [
        "ACCEPTED_CANONICAL",
        "ACCEPTED_WITH_VARIANTS",
        "BLOCKED_UNRESOLVED",
        "HIERARCHICAL_RELATION_ONLY",
        "INSUFFICIENT_AUTHORITY",
        "REJECTED",
        "REJECTED_SEMANTIC_ARTIFACT",
        "SPLIT_REQUIRED"
      ]
    },
    "canonical_family_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^JFAM-[0-9]{6}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "canonical_proposition": {
      "anyOf": [
        {
          "$ref": "https://rawlsing.local/schemas/p3/v7/canonical_proposition.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "accepted_members": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "excluded_members": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "variant_assignments": {
      "type": "array",
      "items": {
        "$ref": "https://rawlsing.local/schemas/p3/v7/variant_assignment.schema.json"
      }
    },
    "hierarchical_relations": {
      "type": "array",
      "items": {
        "$ref": "https://rawlsing.local/schemas/p3/v7/hierarchy_relation.schema.json"
      }
    },
    "collision_dispositions": {
      "type": "array",
      "items": {
        "$ref": "https://rawlsing.local/schemas/p3/v7/collision_disposition.schema.json"
      }
    },
    "response_portability_status": {
      "const": "NOT_AUTHORIZED_BY_P3"
    },
    "unresolved_boundaries": {
      "type": "array",
      "items": {
        "$ref": "https://rawlsing.local/schemas/p3/v7/unresolved_boundary.schema.json"
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "evidence_bundle_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "supersedes_adjudication_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^P3ADJ-[0-9]{6}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "authority_release_id": {
      "type": "string",
      "pattern": "^P3-AUTHORITY-[0-9]{4}-[0-9]{2}-[0-9]{2}-R[0-9]+$"
    },
    "split_points": {
      "type": "array",
      "items": {
        "$ref": "https://rawlsing.local/schemas/p3/v7/split_point.schema.json"
      }
    },
    "decision_ordinal": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "split_results": {
      "type": "array",
      "items": {
        "$ref": "https://rawlsing.local/schemas/p3/v7/split_result.schema.json"
      }
    },
    "variant_promotions": {
      "type": "array",
      "items": {
        "$ref": "https://rawlsing.local/schemas/p3/v7/variant_promotion.schema.json"
      }
    },
    "exclusion_promotions": {
      "type": "array",
      "items": {
        "$ref": "https://rawlsing.local/schemas/p3/v7/exclusion_promotion.schema.json"
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "decision_status": {
            "enum": [
              "ACCEPTED_CANONICAL",
              "ACCEPTED_WITH_VARIANTS"
            ]
          }
        },
        "required": [
          "decision_status"
        ]
      },
      "then": {
        "required": [
          "canonical_family_id",
          "canonical_proposition"
        ],
        "properties": {
          "canonical_family_id": {
            "type": "string",
            "pattern": "^JFAM-[0-9]{6}$"
          },
          "canonical_proposition": {
            "$ref": "https://rawlsing.local/schemas/p3/v7/canonical_proposition.schema.json"
          },
          "accepted_members": {
            "minItems": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision_status": {
            "const": "ACCEPTED_WITH_VARIANTS"
          }
        },
        "required": [
          "decision_status"
        ]
      },
      "then": {
        "properties": {
          "variant_assignments": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision_status": {
            "const": "BLOCKED_UNRESOLVED"
          }
        },
        "required": [
          "decision_status"
        ]
      },
      "then": {
        "properties": {
          "unresolved_boundaries": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision_status": {
            "enum": [
              "REJECTED",
              "REJECTED_SEMANTIC_ARTIFACT",
              "INSUFFICIENT_AUTHORITY",
              "BLOCKED_UNRESOLVED",
              "SPLIT_REQUIRED",
              "HIERARCHICAL_RELATION_ONLY"
            ]
          }
        },
        "required": [
          "decision_status"
        ]
      },
      "then": {
        "properties": {
          "canonical_family_id": {
            "type": "null"
          },
          "canonical_proposition": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision_status": {
            "const": "SPLIT_REQUIRED"
          }
        },
        "required": [
          "decision_status"
        ]
      },
      "then": {
        "properties": {
          "split_points": {
            "minItems": 1
          },
          "split_results": {
            "minItems": 2
          }
        },
        "required": [
          "split_results"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "decision_status": {
            "const": "HIERARCHICAL_RELATION_ONLY"
          }
        },
        "required": [
          "decision_status"
        ]
      },
      "then": {
        "properties": {
          "hierarchical_relations": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision_status": {
            "enum": [
              "BLOCKED_UNRESOLVED",
              "INSUFFICIENT_AUTHORITY"
            ]
          }
        },
        "required": [
          "decision_status"
        ]
      },
      "then": {
        "properties": {
          "unresolved_boundaries": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision_status": {
            "const": "ACCEPTED_WITH_VARIANTS"
          }
        },
        "required": [
          "decision_status"
        ]
      },
      "then": {
        "properties": {
          "variant_promotions": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision_status": {
            "enum": [
              "ACCEPTED_CANONICAL",
              "ACCEPTED_WITH_VARIANTS"
            ]
          }
        },
        "required": [
          "decision_status"
        ]
      },
      "then": {
        "properties": {
          "exclusion_promotions": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision_status": {
            "const": "SPLIT_REQUIRED"
          }
        },
        "required": [
          "decision_status"
        ]
      },
      "then": {
        "properties": {
          "accepted_members": {
            "maxItems": 0
          },
          "excluded_members": {
            "maxItems": 0
          },
          "variant_assignments": {
            "maxItems": 0
          },
          "hierarchical_relations": {
            "maxItems": 0
          },
          "unresolved_boundaries": {
            "maxItems": 0
          },
          "variant_promotions": {
            "maxItems": 0
          },
          "exclusion_promotions": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision_status": {
            "const": "HIERARCHICAL_RELATION_ONLY"
          }
        },
        "required": [
          "decision_status"
        ]
      },
      "then": {
        "properties": {
          "accepted_members": {
            "maxItems": 0
          },
          "excluded_members": {
            "maxItems": 0
          },
          "variant_assignments": {
            "maxItems": 0
          },
          "split_points": {
            "maxItems": 0
          },
          "split_results": {
            "maxItems": 0
          },
          "unresolved_boundaries": {
            "maxItems": 0
          },
          "variant_promotions": {
            "maxItems": 0
          },
          "exclusion_promotions": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision_status": {
            "const": "REJECTED"
          }
        },
        "required": [
          "decision_status"
        ]
      },
      "then": {
        "properties": {
          "accepted_members": {
            "maxItems": 0
          },
          "variant_assignments": {
            "maxItems": 0
          },
          "split_points": {
            "maxItems": 0
          },
          "split_results": {
            "maxItems": 0
          },
          "hierarchical_relations": {
            "maxItems": 0
          },
          "unresolved_boundaries": {
            "maxItems": 0
          },
          "variant_promotions": {
            "maxItems": 0
          },
          "exclusion_promotions": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision_status": {
            "const": "REJECTED_SEMANTIC_ARTIFACT"
          }
        },
        "required": [
          "decision_status"
        ]
      },
      "then": {
        "properties": {
          "accepted_members": {
            "maxItems": 0
          },
          "variant_assignments": {
            "maxItems": 0
          },
          "split_points": {
            "maxItems": 0
          },
          "split_results": {
            "maxItems": 0
          },
          "hierarchical_relations": {
            "maxItems": 0
          },
          "unresolved_boundaries": {
            "maxItems": 0
          },
          "variant_promotions": {
            "maxItems": 0
          },
          "exclusion_promotions": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
