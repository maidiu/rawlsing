{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rawlsing P3 Candidate Adjudication Packet",
  "type": "object",
  "required": [
    "packet_id",
    "candidate_family",
    "members_by_source",
    "proposition_signature_matrix",
    "internal_pair_matrix",
    "hard_collisions",
    "closure_obligations",
    "proposed_variants",
    "explicit_exclusions",
    "exact_evidence_links",
    "decision_form"
  ],
  "properties": {
    "packet_id": {
      "type": "string",
      "pattern": "^P3PKT-[0-9]{6}$"
    },
    "candidate_family": {
      "$ref": "candidate_family.schema.json"
    },
    "members_by_source": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "proposition_signature_matrix": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "response_contract_matrix": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "internal_pair_matrix": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "hard_collisions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "unresolved_pairs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "unruled_pairs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "closure_obligations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "likely_split_points": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "proposed_variants": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "explicit_exclusions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "hyperedge_context": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "strata_horizon_context": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "exact_evidence_links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "evidence_bundle_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decision_form": {
      "$ref": "adjudication_decision.schema.json"
    }
  },
  "additionalProperties": false
}
