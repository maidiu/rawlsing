{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rawlsing P3 Family Genealogy",
  "type": "object",
  "required": [
    "genealogy_id",
    "relation_type",
    "predecessor_family_ids",
    "successor_family_ids",
    "authority_release_id"
  ],
  "properties": {
    "genealogy_id": {
      "type": "string",
      "pattern": "^P3GEN-[0-9]{6}$"
    },
    "relation_type": {
      "enum": [
        "SPLIT",
        "MERGE",
        "SUPERSEDE",
        "DEPRECATE"
      ]
    },
    "predecessor_family_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "successor_family_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "reason": {
      "type": "string"
    },
    "adjudication_id": {
      "type": "string"
    },
    "authority_release_id": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
