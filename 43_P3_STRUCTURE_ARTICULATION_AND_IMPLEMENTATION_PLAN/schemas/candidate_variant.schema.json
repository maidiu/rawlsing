{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rawlsing P3 Candidate Variant",
  "type": "object",
  "required": [
    "variant_id",
    "candidate_or_family_id",
    "variant_dimension",
    "variant_value",
    "member_ids",
    "value_portability_status"
  ],
  "properties": {
    "variant_id": {
      "type": "string",
      "pattern": "^P3VAR-[0-9]{6}$"
    },
    "candidate_or_family_id": {
      "type": "string"
    },
    "variant_dimension": {
      "enum": [
        "RESPONSE_TOPOLOGY",
        "WORDING_TRANSLATION",
        "SOURCE_RESPONSE_FORM",
        "HISTORICAL_INTERVAL",
        "OTHER_EXPLICITLY_GOVERNED"
      ]
    },
    "variant_value": {
      "type": "string"
    },
    "member_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "value_portability_status": {
      "const": "NOT_AUTHORIZED_BY_P3"
    },
    "authority_release_id": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
