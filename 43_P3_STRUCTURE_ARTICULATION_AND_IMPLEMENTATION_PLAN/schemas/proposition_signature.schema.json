{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rawlsing P3 Proposition Signature",
  "type": "object",
  "required": [
    "signature_id",
    "subject_id",
    "subject_type",
    "fields",
    "response_topologies",
    "signature_status",
    "authority_release_id"
  ],
  "properties": {
    "signature_id": {
      "type": "string",
      "pattern": "^PSIG-[0-9]{6}$"
    },
    "subject_id": {
      "type": "string"
    },
    "subject_type": {
      "enum": [
        "SOURCE_LOCAL_LINEAGE",
        "P3_LINEAGE_SEGMENT"
      ]
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "field_name",
          "field_value",
          "evidence_state"
        ],
        "properties": {
          "field_name": {
            "type": "string"
          },
          "field_value": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_state": {
            "enum": [
              "KNOWN",
              "EXPLICITLY_UNSPECIFIED",
              "NOT_APPLICABLE",
              "UNRECOVERED",
              "HETEROGENEOUS",
              "CONFLICTING",
              "DIAGNOSTIC_ONLY"
            ]
          },
          "evidence_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW",
              "NOT_APPLICABLE"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "response_topologies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "signature_status": {
      "enum": [
        "COMPLETE",
        "PARTIAL_FAIL_CLOSED",
        "HETEROGENEOUS",
        "CONFLICTING"
      ]
    },
    "authority_release_id": {
      "type": "string"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
