{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rawlsing.pre553.as3r3.runtime_producer_input.schema.json",
  "title": "AS3R3 bounded successor runtime-object producer input contract",
  "description": "Schema only: no final 19+3 production records, successor runtime refs, aggregate runtime hashes, or AS3R2 target hashes are serialized here.",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitBlobSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "exactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "object_id",
        "content_hash"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "authorityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_id",
        "authority_version",
        "authority_content_hash"
      ],
      "properties": {
        "authority_id": {
          "type": "string",
          "minLength": 1
        },
        "authority_version": {
          "type": "string",
          "minLength": 1
        },
        "authority_content_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "semanticSourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "as3_id",
        "object_id",
        "content_hash"
      ],
      "properties": {
        "as3_id": {
          "type": "string",
          "minLength": 1
        },
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "producerReplayRoot": {
      "allOf": [
        {
          "$ref": "#/$defs/exactRef"
        },
        {
          "properties": {
            "kind": {
              "const": "AS3R3_RUNTIME_OBJECT_PRODUCER"
            }
          }
        }
      ]
    },
    "authorityRoles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hq_succession_adoption_ref",
        "as3_semantic_catalog_authority_ref",
        "as3r2_historical_provenance_authority_ref",
        "as3r1_support_rule_authority_ref_if_relevant"
      ],
      "properties": {
        "hq_succession_adoption_ref": {
          "$ref": "#/$defs/authorityRef"
        },
        "as3_semantic_catalog_authority_ref": {
          "$ref": "#/$defs/authorityRef"
        },
        "as3r2_historical_provenance_authority_ref": {
          "$ref": "#/$defs/authorityRef"
        },
        "as3r1_support_rule_authority_ref_if_relevant": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/authorityRef"
            }
          ]
        }
      }
    },
    "semanticDerivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "source_git_blob_sha",
        "source_row_id",
        "mapping_rule_id",
        "mapping_authority_ref",
        "derivation_mode"
      ],
      "properties": {
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "source_git_blob_sha": {
          "$ref": "#/$defs/gitBlobSha"
        },
        "source_row_id": {
          "type": "string",
          "minLength": 1
        },
        "mapping_rule_id": {
          "type": "string",
          "minLength": 1
        },
        "mapping_authority_ref": {
          "$ref": "#/$defs/authorityRef"
        },
        "derivation_mode": {
          "const": "EXACT_GOVERNED_NO_HEURISTIC_REWRITE"
        }
      }
    },
    "predicateInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_schema",
        "as3_semantic_source_identity",
        "semantic_derivation",
        "authority_roles",
        "typed_state",
        "authority_snapshot_refs",
        "dependency_refs",
        "producer_replay_locator_or_reference_root",
        "semantic_fields"
      ],
      "properties": {
        "input_schema": {
          "const": "PRE553_AS3R3_SUCCESSOR_PREDICATE_INPUT@1.0.0"
        },
        "as3_semantic_source_identity": {
          "$ref": "#/$defs/semanticSourceIdentity"
        },
        "semantic_derivation": {
          "$ref": "#/$defs/semanticDerivation"
        },
        "authority_roles": {
          "$ref": "#/$defs/authorityRoles"
        },
        "typed_state": {
          "const": "PREDICATE_RESOLVED_AUTHORIZED"
        },
        "authority_snapshot_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/authorityRef"
          }
        },
        "dependency_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/exactRef"
          }
        },
        "producer_replay_locator_or_reference_root": {
          "$ref": "#/$defs/producerReplayRoot"
        },
        "semantic_fields": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "predicate_ast",
            "grammar_authority_ref",
            "coordinate_question_value_refs",
            "risk_set_refs",
            "scope_refs",
            "same_respondent_binding_semantics",
            "operator_semantics_refs"
          ],
          "properties": {
            "predicate_ast": {
              "type": "object"
            },
            "grammar_authority_ref": {
              "$ref": "#/$defs/authorityRef"
            },
            "coordinate_question_value_refs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/exactRef"
              }
            },
            "risk_set_refs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/exactRef"
              }
            },
            "scope_refs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/exactRef"
              }
            },
            "same_respondent_binding_semantics": {
              "not": {
                "type": "null"
              }
            },
            "operator_semantics_refs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/exactRef"
              }
            }
          }
        }
      }
    },
    "queryInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_schema",
        "as3_semantic_source_identity",
        "semantic_derivation",
        "authority_roles",
        "typed_state",
        "authority_snapshot_refs",
        "dependency_refs",
        "producer_replay_locator_or_reference_root",
        "semantic_fields"
      ],
      "properties": {
        "input_schema": {
          "const": "PRE553_AS3R3_SUCCESSOR_QUERY_INPUT@1.0.0"
        },
        "as3_semantic_source_identity": {
          "$ref": "#/$defs/semanticSourceIdentity"
        },
        "semantic_derivation": {
          "$ref": "#/$defs/semanticDerivation"
        },
        "authority_roles": {
          "$ref": "#/$defs/authorityRoles"
        },
        "typed_state": {
          "const": "QUERY_AUTHORIZED_RESOLVABLE"
        },
        "authority_snapshot_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/authorityRef"
          }
        },
        "dependency_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/exactRef"
          }
        },
        "producer_replay_locator_or_reference_root": {
          "$ref": "#/$defs/producerReplayRoot"
        },
        "semantic_fields": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target_refs",
            "target_arity_and_topology",
            "condition_predicate_ref",
            "risk_set_ref",
            "empirical_universe_refs",
            "scope_refs",
            "measure_basis_ref",
            "requested_output_grain",
            "query_authority_refs"
          ],
          "properties": {
            "target_refs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/exactRef"
              }
            },
            "target_arity_and_topology": {
              "type": "object"
            },
            "condition_predicate_ref": {
              "$ref": "#/$defs/exactRef"
            },
            "risk_set_ref": {
              "$ref": "#/$defs/exactRef"
            },
            "empirical_universe_refs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/exactRef"
              }
            },
            "scope_refs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/exactRef"
              }
            },
            "measure_basis_ref": {
              "$ref": "#/$defs/exactRef"
            },
            "requested_output_grain": {
              "type": "object"
            },
            "query_authority_refs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/authorityRef"
              }
            }
          }
        }
      }
    },
    "terrainClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "accepted_as3",
        "predicate_count",
        "query_count",
        "predicate_semantic_catalog_hash",
        "query_semantic_catalog_hash",
        "risk_partition_count",
        "measure_partition",
        "topology_partition_count",
        "risk_measure_topology_identity_hash",
        "K",
        "J",
        "recursive_depth",
        "candidate_count",
        "candidate_semantic_frontier_hash",
        "candidate_ordering_law",
        "completion_law",
        "rng",
        "minimum_raw_denominator",
        "support_rule_id",
        "support_rule_hash",
        "common_I03_git_blob_sha",
        "typed_nonpositive_learned_preV3_target_git_blob_sha",
        "common_measurement_law_git_blob_sha",
        "route_B_common_candidate_terrain_git_blob_sha",
        "route_C_accelerator_spec_git_blob_sha",
        "route_C_invalidation_spec_git_blob_sha",
        "route_A_common_candidate_terrain_git_blob_sha"
      ],
      "properties": {
        "schema": {
          "const": "PRE553_AS3R3_FROZEN_TERRAIN_COMPATIBILITY_CLAIM@1.0.0"
        },
        "accepted_as3": {
          "const": "da36f2457513acf2ce734f3509236ef6d2dceec5"
        },
        "predicate_count": {
          "const": 19
        },
        "query_count": {
          "const": 3
        },
        "predicate_semantic_catalog_hash": {
          "const": "8c559917640242e017b03e206d5a0a950cb2973c36a90e0be43d3c0fe7cc9293"
        },
        "query_semantic_catalog_hash": {
          "const": "f76ddf2b8a99e6a05884d503aa7a5da8fbf1fb3b07fbcd4cc93597457defa423"
        },
        "risk_partition_count": {
          "const": 1
        },
        "measure_partition": {
          "const": "RAW_ONLY"
        },
        "topology_partition_count": {
          "const": 2
        },
        "risk_measure_topology_identity_hash": {
          "const": "ed3b76242a588a5e2d4dacbb76f17ceef6185cd27a4080a2e8fb436056abfabf"
        },
        "K": {
          "const": 18
        },
        "J": {
          "const": 2
        },
        "recursive_depth": {
          "const": 18
        },
        "candidate_count": {
          "const": 82
        },
        "candidate_semantic_frontier_hash": {
          "const": "ec85fc2c6460a8a014ae90c54e5847f883c495708c32898ea44bfc0ef78c54e6"
        },
        "candidate_ordering_law": {
          "const": "CANONICAL_CANDIDATE_HASH_ORDER"
        },
        "completion_law": {
          "const": "NONE_EXACT_EVALUATE_ALL"
        },
        "rng": {
          "const": "NONE"
        },
        "minimum_raw_denominator": {
          "const": 0
        },
        "support_rule_id": {
          "const": "PRE553_PRODUCTION_I05_NO_ADDITIONAL_MINIMUM_RAW_DENOMINATOR@1.0.0"
        },
        "support_rule_hash": {
          "const": "6df2664f4a9cd8fe5d334b954aed4db1b97de4937b4d03e5ce63bcc322baab4c"
        },
        "common_I03_git_blob_sha": {
          "const": "3194ccbd4aede70f587bce32c7d0b70c54a17f4c"
        },
        "typed_nonpositive_learned_preV3_target_git_blob_sha": {
          "const": "8527efc27dc23ebba4e7a212a1d6c152c18f720a"
        },
        "common_measurement_law_git_blob_sha": {
          "const": "7c13a3e100e84154c86efa90b0257dc63c0485d0"
        },
        "route_B_common_candidate_terrain_git_blob_sha": {
          "const": "93b7e23650b3544669ee15e424f42c4ea807ade1"
        },
        "route_C_accelerator_spec_git_blob_sha": {
          "const": "34d2d21e51cff0995301e04bfef994b97c6cc5d8"
        },
        "route_C_invalidation_spec_git_blob_sha": {
          "const": "4fda5eb6ae5c6b215bfeb3a42b111bf6f8880f8a"
        },
        "route_A_common_candidate_terrain_git_blob_sha": {
          "const": "030b2b98fa2fb38be51cb38bc52d6401fd304d04"
        }
      }
    },
    "futureInputBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "predicate_inputs",
        "query_inputs",
        "terrain_claim"
      ],
      "properties": {
        "schema": {
          "const": "PRE553_AS3R3_SUCCESSOR_RUNTIME_INPUT_BUNDLE@1.0.0"
        },
        "predicate_inputs": {
          "type": "array",
          "minItems": 19,
          "maxItems": 19,
          "items": {
            "$ref": "#/$defs/predicateInput"
          }
        },
        "query_inputs": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/queryInput"
          }
        },
        "terrain_claim": {
          "$ref": "#/$defs/terrainClaim"
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/predicateInput"
    },
    {
      "$ref": "#/$defs/queryInput"
    },
    {
      "$ref": "#/$defs/futureInputBundle"
    }
  ]
}
