{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rawlsing.cross-hq.environment-passport@1",
  "title": "Rawlsing sanitized execution-environment passport",
  "description": "Non-secret documentary operating state for Pyat and Sorok routing. Never independently proves runtime survival, source permissions or scientific adoption.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "environment_id",
    "epoch_id",
    "surface",
    "status",
    "live_probe",
    "source_closure",
    "assignments_completed",
    "next_affinity_tags",
    "permissions",
    "usage"
  ],
  "properties": {
    "schema": {
      "const": "RAWLSING_ENVIRONMENT_PASSPORT@1"
    },
    "environment_id": {
      "type": "string",
      "minLength": 1
    },
    "epoch_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "surface": {
      "enum": [
        "BROWSER_CONTAINER",
        "LOCAL_SHARED_STORE",
        "CI",
        "SPECIALIZED",
        "UNKNOWN"
      ]
    },
    "session_alias": {
      "type": [
        "string",
        "null"
      ]
    },
    "machine_alias": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "LIVE_VERIFIED",
        "STALE_RECHECK_REQUIRED",
        "NOT_ACCESSIBLE",
        "RETIRED",
        "RECONSTRUCTED",
        "UNKNOWN"
      ]
    },
    "live_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_at_utc",
        "marker_checked",
        "marker_digest",
        "python",
        "pytest",
        "git",
        "filesystem",
        "connector",
        "notes"
      ],
      "properties": {
        "observed_at_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "marker_checked": {
          "enum": [
            "VERIFIED",
            "MISSING",
            "NOT_CHECKED",
            "UNKNOWN"
          ]
        },
        "marker_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "python": {
          "type": [
            "string",
            "null"
          ]
        },
        "pytest": {
          "type": [
            "string",
            "null"
          ]
        },
        "git": {
          "type": [
            "string",
            "null"
          ]
        },
        "filesystem": {
          "enum": [
            "VERIFIED",
            "UNAVAILABLE",
            "UNKNOWN"
          ]
        },
        "connector": {
          "enum": [
            "VERIFIED",
            "UNAVAILABLE",
            "UNKNOWN"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "branch": {
      "type": [
        "string",
        "null"
      ]
    },
    "checkout_sha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "shared_store_alias": {
      "type": [
        "string",
        "null"
      ]
    },
    "worktree_alias": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_closure": {
      "enum": [
        "FULL",
        "BOUNDED",
        "PARTIAL",
        "NONE",
        "UNKNOWN"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "commit",
          "path",
          "blob_sha1",
          "import_verified"
        ],
        "properties": {
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "blob_sha1": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "module_alias": {
            "type": [
              "string",
              "null"
            ]
          },
          "import_verified": {
            "type": "boolean"
          },
          "relative_stage_path": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope",
          "status"
        ],
        "properties": {
          "scope": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN",
              "ERROR",
              "SKIP"
            ]
          },
          "command": {
            "type": [
              "string",
              "null"
            ]
          },
          "receipt_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "test_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "claim_grade": {
            "enum": [
              "STANDALONE_SOURCEFREE",
              "EXACT_OWNER_SOURCEFREE",
              "ORIGINAL_SOURCE",
              "V3_ACTOR",
              "UNKNOWN"
            ]
          }
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "private_repo_access",
        "original_survey_use",
        "external_model_use",
        "actor_execution"
      ],
      "properties": {
        "private_repo_access": {
          "enum": [
            "VERIFIED",
            "USER_REPORTED",
            "UNAVAILABLE",
            "UNKNOWN"
          ]
        },
        "original_survey_use": {
          "enum": [
            "EXPLICITLY_GRANTED",
            "NOT_GRANTED",
            "UNKNOWN"
          ]
        },
        "external_model_use": {
          "enum": [
            "EXPLICITLY_GRANTED",
            "NOT_GRANTED",
            "UNKNOWN"
          ]
        },
        "actor_execution": {
          "enum": [
            "EXPLICITLY_GRANTED",
            "NOT_GRANTED",
            "UNKNOWN"
          ]
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_model",
        "incremental_cash_usd",
        "quota_state",
        "usage_observed",
        "retry_count"
      ],
      "properties": {
        "provider_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "incremental_cash_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "quota_state": {
          "type": [
            "string",
            "null"
          ]
        },
        "usage_observed": {
          "type": [
            "string",
            "null"
          ]
        },
        "retry_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "assignments_completed": {
      "type": "integer",
      "minimum": 0
    },
    "next_affinity_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "independence_conflict": {
      "type": [
        "string",
        "null"
      ]
    },
    "retirement_reason": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
