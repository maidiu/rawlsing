  "R00_rules": [
    {
      "id": "P00_INDEPENDENT_PIN",
      "behavior": "Resolve policy only from separately sealed immutable commit/path/digests; compare claimed digest but never accept caller-supplied pair as authority"
    },
    {
      "id": "P01_OCCURRENCE_ROLE_AND_MEASURE",
      "behavior": "Conserve independent expected tuples including form/repeat/rank/option, unit/risk, typed value, direction/measure; eligibility frozen before response values"
    },
    {
      "id": "P02_NO_ADMIN_AS_CONDITION",
      "behavior": "Administrative-only occurrence cannot be promoted into empirical conditioner without declared scientific authorization"
    },
    {
      "id": "P03_NO_UNLINKED_CROSS_UNIT",
      "behavior": "Cross unit operation HELD absent exact issued link; new grant alone does not prove implemented joint"
    },
    {
      "id": "P04_NOT_ADMINISTERED",
      "behavior": "Explicit NOT_ADMINISTERED is INAPPLICABLE_PROVED only at that source-specified grain; cannot become eligible or positive"
    },
    {
      "id": "P05_HELD_ROLE",
      "behavior": "Unissued target/condition science stays UNKNOWN or HELD, never silently missing or excluded"
    },
    {
      "id": "P06_NO_DROP_MULTISETS",
      "behavior": "Compare full exact independent operation IDs and semantic fields; omitted+added one with same count fails; duplicates fail"
    },
    {
      "id": "P07_SEPARATE_STATES",
      "behavior": "Preserve independent eligibility, execution, result axes plus exact native type; PENDING/UNKNOWN cannot pass completed"
    },
    {
      "id": "P08_CLAIM_GRADE_CEILING",
      "behavior": "Local scoped positive stays local; generic requires independent G0–G7, original requires G8 plus actual source original"
    },
    {
      "id": "P09_RUNTIME_PROVENANCE_HOLD",
      "behavior": "Candidate native=true, trace names, self-authored hashes, alleged signatures and TEST_ONLY mock transports never authenticate native events or generic"
    },
    {
      "id": "P10_EXACT_K_AND_CURRENTNESS",
      "behavior": "Versioned K includes source edition, source digest, occurrence option/form/repeat, unit/risk, ordered target/condition and values, estimand/design/uncertainty/roles/releases, permission, observation/asof clocks, consumer use"
    },
    {
      "id": "P11_REPLAY_AND_DEDUP",
      "behavior": "Repeated computation allowed with distinct attempt lineage; counting the same scientific operation twice or unapproved replay refuses"
    },
    {
      "id": "P12_EMPTY_NULL_ZERO_DISTINCT",
      "behavior": "Valid zero/null/diffuse/empty remain exact scientific typed results where warranted; empty success cannot stand in for a missing eligible operation"
    },
    {
      "id": "P13_ORIGINAL_ROSTER_CONSERVATION",
      "behavior": "All 35 SRC×54 IDs plus global F6/F7/F8 remain state-accounted; no null U/Epre can be converted to NA or synthetic completion"
    },
    {
      "id": "P14_FAIL_CLOSED_TRUST",
      "behavior": "Unavailable verifier/permission/protected runner returns typed HOLD not fabricated pass"
    },
    {
      "id": "P15_ACTUAL_CONSUMER",
      "behavior": "Evidence must bind exact request K and actual same-request consumer values-read; labels and unrelated separate default calls inadequate"
    }
  ],
