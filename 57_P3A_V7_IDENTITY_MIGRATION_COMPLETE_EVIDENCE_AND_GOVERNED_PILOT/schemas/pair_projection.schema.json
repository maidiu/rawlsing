{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rawlsing.local/schemas/p3/v7/pair_projection.schema.json",
  "title": "pair_projection",
  "type": "object",
  "required": [
    "projection_id",
    "pair_fact_id",
    "left_subject_id",
    "right_subject_id",
    "projection_basis",
    "evidence_ids",
    "authority_release_id"
  ],
  "properties": {
    "projection_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^P3PROJ-[0-9a-f]{16}$"
    },
    "pair_fact_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^P3PF-[0-9a-f]{16}$"
    },
    "left_subject_id": {
      "type": "string",
      "minLength": 1
    },
    "right_subject_id": {
      "type": "string",
      "minLength": 1
    },
    "projection_basis": {
      "enum": [
        "ORIGINAL_LINEAGES",
        "SEGMENT_BINDING"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "authority_release_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^P3-AUTHORITY-[0-9]{4}-[0-9]{2}-[0-9]{2}-R[0-9]+$"
    }
  },
  "additionalProperties": false
}
