    "SC0_cases": [
      {
        "id": "K9_01_TWO_PROVIDERS_SAME_MEANING",
        "procedure": [
          "load A then B under identical use ceiling",
          "resolve same world demand with same four clocks",
          "query three ordered empirical steps",
          "dereference all semantic objects",
          "invoke each of two consumers under same rule version"
        ],
        "assertions": [
          "schema_valid(A) && schema_valid(B)",
          "semantic_world_projection(A)==semantic_world_projection(B)",
          "ordered_possibility_projection(A)==ordered_possibility_projection(B)",
          "both_consumer_effects(A)==both_consumer_effects(B)",
          "physical_provider_id(A)!=physical_provider_id(B)"
        ],
        "expected": "EQUIVALENT_EXCEPT_DECLARED_PHYSICAL_LINEAGE"
      },
      {
        "id": "K9_02_INDEPENDENT_NONPARENT",
        "procedure": [
          "use NONPARENT_APPRENTICESHIP_ENTRY",
          "exclude genealogical selectors from request"
        ],
        "assertions": [
          "requires_no_parent_or_coparent_tag",
          "selected_apprenticeship_routes_equal",
          "no_person_generation"
        ],
        "expected": "GENERIC_API_CONSUMED_WITHOUT_GENEALOGY"
      },
      {
        "id": "K9_03_ID_REORDER_AND_STAGE_RENAME",
        "procedure": [
          "B shuffles physical record order and renames all stage-shaped files",
          "semantic refs and values preserved"
        ],
        "assertions": [
          "no_stage_name_dependency",
          "all roles/order unchanged",
          "semantic projections equal"
        ],
        "expected": "EQUIVALENT"
      },
      {
        "id": "K9_04_NOT_EQUIVALENT_CONTRAST",
        "procedure": [
          "B omits sponsor participant or converts triad into dyads"
        ],
        "assertions": [
          "world_projection_inequality_detected",
          "port must reject lost role"
        ],
        "expected": "FAIL_NON_EQUIVALENT_PROVIDER_NOT_PERMITTED_NORMALIZATION"
      },
      {
        "id": "K9_05_MODELLED_VS_OBSERVED",
        "procedure": [
          "B marks fixture synthetic route as observed source fact"
        ],
        "assertions": [
          "epistemic_grade_difference_detected",
          "reject promotion"
        ],
        "expected": "REFUSE_GRADE_PROMOTION"
      },
      {
        "id": "K9_06_FORWARD_REVERSE",
        "procedure": [
          "request reversal from B without separate target risk-set issuer"
        ],
        "assertions": [
          "no_calculation_of_reverse_from_forward",
          "forward_legal_slice_preserved"
        ],
        "expected": "HELD_AUTHORITY_REVERSE_ROLE"
      },
      {
        "id": "K9_07_PERMISSIONS",
        "procedure": [
          "B drops dependency use atom while preserving bytes"
        ],
        "assertions": [
          "denied_requested_slice",
          "no cached A bypass"
        ],
        "expected": "DENIED_USE"
      },
      {
        "id": "K9_08_TWO_CHANNEL_REFRESH",
        "procedure": [
          "same timestamp, generated location binding changes",
          "next run crosses publication boundary independently"
        ],
        "assertions": [
          "binding_change_causes_new_query",
          "publication_boundary_causes_separate_successor",
          "prior_receipts_immutable"
        ],
        "expected": "TWO_INDEPENDENT_SUCCESSORS"
      }
    ],
