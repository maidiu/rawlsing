        "properties": {
          "status": {
            "const": "PASS"
          },
          "expected_identity": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "observed_identity": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
