    "accepted_astra_source_identity",
    "current_d03_authority_content_hash",
    "current_execution_identity",
    "current_replay_identity",
    "expected_empirical_summary_identity",
    "observed_empirical_summary_identity",
    "section_results",
    "section_identities",
    "historical_current_whole_object_hash_equality_required",
    "whole_object_hashes_compared_across_schema_domains",
    "candidate_processes_started",
    "candidate_outputs_seen",
    "candidate_owned_state_reused",
