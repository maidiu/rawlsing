{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rawlsing:fiabc:lits-astra-substantive-parity-receipt:1.0.0",
  "title": "FIABC LiTS ASTRA Substantive Parity Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
