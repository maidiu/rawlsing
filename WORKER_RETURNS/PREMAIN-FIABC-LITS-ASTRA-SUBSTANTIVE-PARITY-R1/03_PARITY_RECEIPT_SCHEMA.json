    "historical_current_whole_object_hash_equality_required": {
      "const": false
    },
    "whole_object_hashes_compared_across_schema_domains": {
      "const": false
    },
    "candidate_processes_started": {
      "const": 0
    },
    "candidate_outputs_seen": {
      "const": 0
    },
    "candidate_owned_state_reused": {
      "const": false
    },
    "oracle_freeze_authorized": {
      "const": true
    },
    "parity_receipt_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
