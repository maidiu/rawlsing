          "git_blob_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    },
    "accepted_astra_source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "sha256",
        "rows",
        "variables"
      ],
      "properties": {
        "source": {
          "const": "LITS_I"
        },
        "sha256": {
          "const": "7cac43e2ca5b31cb658dc2b3a6cfbcec99363ca8c47da457df90e31b588efc09"
        },
        "rows": {
          "const": 29002
        },
        "variables": {
          "const": 1198
        }
      }
    },
    "current_d03_authority_content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "current_execution_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "current_replay_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "expected_empirical_summary_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "observed_empirical_summary_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "section_results": {
      "type": "object",
      "additionalProperties": {
        "const": "PASS"
      }
    },
    "section_identities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "expected_identity",
          "observed_identity"
