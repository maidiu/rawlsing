{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rawlsing Closure Evidence Packet R1",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_packet_version","obligation_id","terminal_status","closure_condition","closure_authority","authorizing_grounding_receipt_id","evidence_refs","evidence_summary"],
  "properties": {
    "evidence_packet_version":{"const":"RAWLSING_CLOSURE_EVIDENCE_R1"},
    "obligation_id":{"type":"string","pattern":"^OBL[0-9]{3}$"},
    "terminal_status":{"enum":["CLOSED","ABANDONED_BY_EXPLICIT_DECISION"]},
    "closure_condition":{"type":"string","minLength":1},
    "closure_authority":{"type":"string","minLength":1},
    "authorizing_grounding_receipt_id":{"type":"string","minLength":1},
    "evidence_refs":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^[0-9a-f]{40}(:.+)?$"}},
    "evidence_summary":{"type":"string","minLength":1}
  }
}
