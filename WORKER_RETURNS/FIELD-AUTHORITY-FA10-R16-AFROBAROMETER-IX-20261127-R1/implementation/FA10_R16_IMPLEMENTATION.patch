+"""Matched P1 intervention: same role/direction, locator-only versus verified source reveal."""
+from concurrent.futures import ThreadPoolExecutor
+import experiments as e
+import fa10_r16 as r
+
+out=e.WORK/"P1_exact_reveal"
+original=r.fa10.probe("P1_DISTAL","directed",out)
+reveal=r.fa10.reveal("P1_DISTAL","directed",out,e.ARCHIVE,["NOCALL_1"])
+assert original["instruction"]==reveal["instruction"]
+assert set(reveal["fields"])-set(original["fields"])=={"NOCALL_1"}
+pairs={"locator":original,"retrieved":reveal}
+with ThreadPoolExecutor(max_workers=2) as exe:
+    results=dict(zip(pairs,exe.map(lambda name:e.invoke(pairs[name],name,out,6500),pairs)))
+r.save(out/"MATCHED_P1.json",{"results":results,"instruction_identical":True,
+       "source_reveal":reveal["fields"]["NOCALL_1"],
+       "reason":"NOCALL_1 was a real earlier R9 concern about fieldwork denominator and selected sponsor-report observations."})
