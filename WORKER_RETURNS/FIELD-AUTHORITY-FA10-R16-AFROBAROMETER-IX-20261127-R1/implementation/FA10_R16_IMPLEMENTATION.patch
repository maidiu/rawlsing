@@ -0,0 +1,233 @@
+import copy
+import json
+import os
+from pathlib import Path
+import tempfile
+import unittest
+
+import fa10_r16 as r
+
+ARCHIVE = Path(os.environ.get("FA10_ARCHIVE", str(Path.home() / "Desktop/Rawlsing/source_files/Rawlsing 35 waves of savs & dtas.zip")))
+
+
+class Court(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.afro = r.fa10.load_source()
+        cls.edition, cls.rows = r.fa10.r9.source(ARCHIVE, "Afrobarometer Round 9 codebook.csv")
+        r.verify_rows(cls.afro["author_base"], cls.edition, cls.rows)
+
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.root = Path(self.tmp.name)
+        self.db = r.Sidecar(self.root / "state.json", self.edition, self.rows, ["Afro", "other"], limit=4)
+        self.d = self.db.seed("D:Q53C:6", "Afro", "D", "ANSWER", {"meaning":"Refusal"})
+        self.i = self.db.seed("I:recognition", "Afro", "I", "INQUIRY", {"note":"Compare expected sanctions"},
+                              [{"kind":"REQUIRED", "ref":self.d}])
+        self.untouched = self.db.seed("I:unrelated", "other", "I", "INQUIRY", {"note":"Different scope"})
+        self.o = self.db.seed("O:Q53C", "Afro", "O", "FIELD", {"note":"Community reaction expected"})
+        self.origin = self.db.register(r.fa10.transport.seal({"source":self.edition,"role":"R"}),
+                                       {"discovery":"Police and community are distinct actors"}, "R", "Afro")
+
+    def evt(self, *, kind="CORRECT", op="PATCH", target=None, identifier="E1", phrase=None):
+        row = self.rows["Q53C"]
+        return {
+            "schema":"FA10_FEEDBACK_EVENT@1", "event_id":identifier, "grade":"PROPOSED_CANDIDATE",
+            "kind":kind, "origin":self.origin, "targets":[target or self.d], "new_scope":None,
+            "evidence":[{"source_sha256":self.edition["sha256"], "locator":"Q53C",
+                         "quote_or_fact":phrase or row["question_text"], "row_sha256":r.digest(row),
+                         "evidence_kind":"LITERAL_ROW"}],
+            "read_dependencies":[], "requested_operation":op, "minimal_delta_or_request":"Keep code 6 distinct",
+            "reason":"Refused states have distinct record identities",
+            "intellectual_consequence":"Preserve comparison under exact alternatives",
+            "known_affected":[], "dependency_scope":"EXPLICIT",
+            "missing_evidence_or_authority":[], "effort_reason":"Single affected relation",
+        }
+
+    def review(self, event, patch=None, decision="APPLY"):
+        packet = r.fa10.transport.seal({"role":"J","source":self.edition,"events":{event["event_id"]:r.digest(event)}})
+        response = {"packet_sha256":packet["packet_sha256"],"decisions":{
+            event["event_id"]:{"decision":decision,"reason":"Checked literal source and the current candidate",
+                                "patch_sha256":r.digest(patch) if patch else None}}}
+        return self.db.register(packet, response, "J", "Afro")
+
+    def apply(self, event, patch, owner="D"):
+        self.assertEqual("ROUTED",self.db.submit(event))
+        return self.db.adjudicate(event["event_id"], self.review(event,patch), owner=owner,patch=patch)
+
+    def test_T01_stage_focus(self):
+        p = r.read(r.ROOT/"wvs/O_PACKET.json")
+        x = r.read(r.ROOT/"wvs/O_RESPONSE.json")
+        self.assertTrue(r.fa10.validate(p,x))
+        x["answer_notes"]["Q119"]={"0":"Hard to say"}
+        with self.assertRaisesRegex(ValueError,"role boundary"):
+            r.fa10.validate(p,x)
+        origin = self.db.register(r.fa10.transport.seal({"source":self.edition,"role":"O"}),
+                                  {"extra":"valid insight"},"O","Afro")
+        event = self.evt(kind="PRESERVE_OVERFLOW",op="CONSERVE")
+        event["origin"] = origin
+        self.assertEqual(self.db.submit(event),"SUPPLEMENTARY")
+        self.assertEqual(self.db.retrieve(self.d["record_id"])["record"]["revision_sha256"],self.d["revision_sha256"])
+
+    def test_T02_refs(self):
+        for i, part in enumerate(("origin","source","field","revision","literal","row")):
+            event=self.evt(identifier=str(i))
+            event["origin"]=dict(event["origin"])
+            anchor=event["evidence"][0]
+            if part=="origin": event["origin"]["packet_sha256"]="0"*64
+            if part=="source": anchor["source_sha256"]="0"*64
+            if part=="field": anchor["locator"]="absent"
+            if part=="revision": event["targets"]=[{**self.d,"revision_sha256":"0"*64}]
+            if part=="literal": anchor["quote_or_fact"]="I am a fabricated fact"
+            if part=="row": anchor["row_sha256"]="0"*64
+            self.assertEqual(self.db.submit(event),"REJECTED")
+        with self.assertRaisesRegex(r.Refused, "nonexistent field or code"):
+            self.db.seed("D:Q53C:9999", "Afro", "D", "ANSWER", {"meaning":"invented"})
+
+    def test_T03_cascade(self):
+        later=self.db.seed("S:later","Afro","S","CLAIM",{"note":"Derived from I"},
+                           [{"kind":"REQUIRED","ref":self.i}])
+        result=self.apply(self.evt(),{"meaning":"Refused code 6, distinct stored state"})
+        self.assertNotEqual(result,self.d)
+        self.assertEqual(self.db.retrieve(self.d["record_id"],revision=self.d["revision_sha256"])["record"]["content"]["meaning"],"Refusal")
+        self.assertTrue(self.db.retrieve(self.i["record_id"])["pending"])
+        self.assertTrue(self.db.retrieve(later["record_id"])["pending"])
+        with self.assertRaisesRegex(r.Refused, "reconsidered first"):
+            self.db.reconsider(later["record_id"],owner="S",decision="KEEP",rationale="Premature")
+        self.assertEqual(self.untouched,r.reference(self.db.retrieve("I:unrelated")["record"]))
+        revived=self.db.reconsider(self.i["record_id"],owner="I",decision="KEEP",rationale="The composition excludes both refusal codes independently")
+        self.assertNotEqual(revived,self.i)
