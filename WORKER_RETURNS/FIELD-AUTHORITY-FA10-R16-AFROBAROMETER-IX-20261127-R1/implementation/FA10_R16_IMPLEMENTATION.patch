+"""Finite four-arm dispatcher around the frozen stage, transport and projection."""
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+import secrets
+import shlex
+import sys
+
+root = Path(__file__).resolve().parent
+sys.path.insert(0, str(root / "frozen"))
+import fa10
+
+work = root / "core"
+work.mkdir(exist_ok=True)
+order_path = work / "CONTROLLER_ONLY_ORDER.json"
+if order_path.exists():
+    order = fa10.r9.read(order_path)
+else:
+    order = secrets.SystemRandom().sample(list(fa10.PLAN["arms"]), 4)
+    fa10.r9.save(order_path, order)
+
+
+def run_arm(arm):
+    for role in fa10.PLAN["arms"][arm]["stages"]:
+        packet = fa10.prepare_stage(arm, role, work)
+        stage = fa10.stage_path(work, arm, role)
+        if (stage / "response.json").exists():
+            fa10.validate(packet, fa10.r9.read(stage / "response.json"))
+            continue
+        cap = fa10.PLAN["budget_proposal"]["stage_caps"][role]
+        cmd = shlex.join([sys.executable, str(root / "opencode_provider.py"), "--cap", str(cap)])
+        for n in ((7,) if any(stage.glob("attempt-*")) else (7, 8)):
+            attempt = f"attempt-{n}"
+            if (stage / attempt).exists():
+                continue
+            try:
+                result, _ = fa10.transport.call(packet, cmd, attempt, stage)
+                fa10.accept(arm, role, work, result)
+            except (ValueError, KeyError, AssertionError, __import__("subprocess").SubprocessError) as exc:
+                fa10.r9.save(stage / f"{attempt}-rejection.json", {"error": type(exc).__name__, "message": str(exc)})
+                print(arm, role, attempt, type(exc).__name__, str(exc), flush=True)
+            else:
+                print(arm, role, "STRUCTURAL_PASS", flush=True)
+                break
+        if not (stage / "accepted.json").exists():
+            return arm, role
+    fa10.project(arm, work)
+    return arm, "PROJECTED"
+
+
+with ThreadPoolExecutor(max_workers=2) as executor:
+    results = list(executor.map(run_arm, order))
+fa10.r9.save(work / "CORE_STATUS.json", dict(results))
+if all(result == "PROJECTED" for _, result in results) and not (work / "blinded").exists():
+    fa10.blind(work)
