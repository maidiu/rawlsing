+"""Scoped, matched production comparisons on the incumbent FA10 transport."""
+from concurrent.futures import ThreadPoolExecutor
+from copy import deepcopy
+import os
+from pathlib import Path
+import secrets
+import shlex
+import sys
+
+import fa10_r16 as r
+
+ROOT = Path(__file__).resolve().parent
+ARCHIVE = Path(os.environ.get("FA10_ARCHIVE", str(Path.home() / "Desktop/Rawlsing/source_files/Rawlsing 35 waves of savs & dtas.zip")))
+MODEL = ROOT / "opencode_provider.py"
+WORK = ROOT / "experiments"
+
+
+def invoke(packet, name, folder, cap=6500):
+    """One physical attempt and exact reuse of its successful response."""
+    folder.mkdir(exist_ok=True, parents=True)
+    target = folder / name
+    if target.exists():
+        receipt = r.read(target / "receipt.json")
+        raw = (target / "stdout.json").read_bytes()
+        r.require((target / "input.json").read_bytes() == r.fa10.r9.canon(packet)
+                  and receipt["stdout_sha256"] == r.fa10.r9.sha(raw), "replayed packet or output differs")
+        envelope = r.read(target / "stdout.json")
+        r.require(receipt["exit_code"] == 0 and envelope.get("response") is not None, "frozen failed attempt")
+        return envelope["response"]
+    command = shlex.join([sys.executable, str(MODEL), "--cap", str(cap)])
+    result, _ = r.fa10.transport.call(packet, command, name, folder)
+    return result
+
+
+def fields(rows, ids):
+    return {k: {"source_metadata": rows[k], "row_sha256": r.digest(rows[k])} for k in ids}
+
+
+def blinded_review(source, metadata, outputs, destination, first, task):
+    mapfile = destination / "CONTROLLER_ONLY_MAP.json"
+    if mapfile.exists():
+        mapping = r.read(mapfile)
+    else:
+        labels = secrets.SystemRandom().sample(list(outputs), len(outputs))
+        mapping = dict(zip([f"sample-{n}" for n in range(1,len(labels)+1)],labels))
+        r.save(mapfile,mapping)
+    packet = r.fa10.transport.seal({
+        "role":"J","source":source,"fields":metadata,"source_first":first,
+        "products":{key:outputs[value] for key,value in mapping.items()},
+        "instruction":task + " Judge exact positive distinctions, counterexamples, omissions, usable inquiries, "
+            "novel operations, false challenges and held dependencies. Return JSON reviews keyed exactly by "
+            "sample labels and shared_misses. Use concrete examples and no scalar score.",
+    })
+    reviewed = invoke(packet,"blind_review",destination)
+    if "reviews" not in reviewed and set(reviewed) == {*mapping, "shared_misses"}:
+        r.save(destination/"REVIEW_ENVELOPE_NORMALIZATION.json",{
+            "original_sha256":r.digest(reviewed),"operation":"Nest exact matching arm keys under reviews"
+        })
+        reviewed={"reviews":{key:reviewed[key] for key in mapping},"shared_misses":reviewed["shared_misses"]}
+    r.require(set(reviewed["reviews"])==set(mapping),"missing review arm")
+    r.save(destination/"FROZEN_REVIEW.json",reviewed)
+    return reviewed
+
+
+def compare_case(name, *, wave, ids, inherited, observation_focus):
+    destination = WORK / name
+    destination.mkdir(exist_ok=True, parents=True)
+    edition, rows = r.fa10.r9.source(ARCHIVE,wave)
+    metadata = fields(rows,ids)
+    source_only = r.fa10.transport.seal({
+        "role":"J","source":edition,"fields":metadata,
+        "instruction":"Before seeing any model product, independently articulate exact positive alternatives and "
+          "their underlying actors, observation gates and plausible competing interpretations. Return JSON "
+          "observations as an array of objects with field_ids, finding, and exact literal evidence; "
+          "also hard_cases, a list of precise confusions to test. No empirical counts or native claims.",
+    })
+    first = invoke(source_only,"source_first_judge",destination,4500)
+
+    common = {
+        "role":"R", "source":edition,"fields":metadata,"required_reads":inherited,
+        "focus":observation_focus,
+        "instruction":(
+            "Develop novel consequential relations from the actual alternative meanings. Preserve actor, "
+            "grain, clock, unknown eligibility, source-special states, rights and rival possibilities. "
+            "Return JSON with findings, upstream, inquiries, method, holds. For each give exact fields, "
+            "literal evidence and interpretation. Keep conceptual proposals separate from empirical claims. "
+            "For upstream provide an object keyed by exact inherited record IDs, each value containing "
+            "proposed_note, quote (verbatim substring), field, reason, and dependence (why a later reader would change). "
+            "Provide positive enrichments and material corrections only where justified. "
+            "A method has input, transformation, output, stop, positive, negative, nontransfer, reader, matched_trial."
+        ),
+    }
+    variants = {
+        "ordinary": "Work as an ordinary targeted reviewer. Inspect the supplied inherited candidates and give the smallest useful suggestions.",
+        "recursive": (
+            "Concentrate on R while allowing discoveries to reopen O or D. Track how each upstream change or enrichment "
+            "moves a dependent inquiry, keep prior wording and dissent retrievable, and specify the few dependents to "
+            "re-evaluate. Distinguish source reconstruction, representation, and intellectual revision. "
+            "In the method output propose a genuinely new useful operation only when evidenced, with a foil and stopping rule."
+        ),
+    }
+    packets = {name:r.fa10.transport.seal({**common,"instruction":common["instruction"]+" "+extra})
+               for name,extra in variants.items()}
+    with ThreadPoolExecutor(max_workers=2) as ex:
+        results = dict(zip(packets,ex.map(lambda key:invoke(packets[key],key,destination), packets)))
+    for key, result in results.items():
+        for member in ("findings","upstream","inquiries","method","holds"):
+            r.require(member in result,"incomplete worker product: "+key+":"+member)
+    reviewed = blinded_review(edition,metadata,results,destination,first,
+                              "Compare matched metadata author returns with their own prior records and source.")
+    return edition, rows, destination, packets, results, reviewed
+
+
+def actual_feedback(edition, rows, destination, packets, results, review, inherited):
+    product = results["recursive"]
+    db = r.Sidecar(destination/"journal.json",edition,rows,["candidate"],limit=6)
+    if (destination/"ACTUAL_FEEDBACK.json").exists():
+        return
+    refs = {}
+    prior_state=r.read(db.path)
+    for rid, value in inherited.items():
+        refs[rid] = (r.reference(db.retrieve(rid)["record"]) if rid in prior_state["active"] else db.seed(rid,"candidate",value["owner"],"FIELD",{"note":value["note"]}))
+    for rid, value in inherited.items():
+        if "I:"+rid in prior_state["active"]:
+            continue
+        db.seed("I:"+rid,"candidate","I","INQUIRY",{"note":value["dependent"]},
+                [{"kind":"REQUIRED","ref":refs[rid]}])
+    if "I:unrelated" not in prior_state["active"]:
+        db.seed("I:unrelated","candidate","I","INQUIRY",{"note":"No required read across these records"})
+    untouched = r.reference(db.retrieve("I:unrelated")["record"])
+    origin=db.register(packets["recursive"],product,"R","candidate")
+    proposed = {}
+    dispositions={eid:entry["status"] for eid,entry in prior_state["events"].items()
+                  if entry["status"] in {"HELD_SOURCE_SCOPE","APPLIED_CANDIDATE"}}
+    for rid, item in product["upstream"].items():
+        if "R:"+rid in dispositions:
+            continue
+        if rid not in refs or not isinstance(item,dict):
+            continue
+        field = item.get("field")
+        if field not in packets["recursive"]["fields"] or not all(r.fa10.r9.substantive(item.get(k)) for k in
+                ("proposed_note","quote","reason","dependence")):
+            continue
+        event = {
+            "schema":"FA10_FEEDBACK_EVENT@1","event_id":"R:"+rid,"grade":"PROPOSED_CANDIDATE",
+            "kind":inherited[rid]["kind"],"origin":origin,"targets":[refs[rid]],"new_scope":None,
+            "evidence":[{"source_sha256":edition["sha256"],"locator":field,"quote_or_fact":item["quote"],
+                         "row_sha256":r.digest(rows[field]),"evidence_kind":"LITERAL_ROW"}],
+            "read_dependencies":[{"ref":refs[rid],"kind":"REQUIRED"}],"requested_operation":"PATCH",
+            "minimal_delta_or_request":item["proposed_note"],"reason":item["reason"],
+            "intellectual_consequence":item["dependence"],"known_affected":[],"dependency_scope":"EXPLICIT",
+            "missing_evidence_or_authority":[],"effort_reason":"Targeted backward review of one exact record",
+        }
+        status=db.submit(event)
+        if status=="ROUTED" or (status=="DUPLICATE" and prior_state["events"][event["event_id"]]["status"]=="ROUTED"):
+            proposed[event["event_id"]] = {"event":event,"rid":rid,"before":inherited[rid]["note"],
+                                           "patch":{"note":item["proposed_note"]}}
+    if proposed:
+        jp=r.fa10.transport.seal({
+            "role":"J","source":edition,"fields":packets["recursive"]["fields"],
+            "events":{eid:r.digest(value["event"]) for eid,value in proposed.items()},
+            "candidates":{eid:{"before":v["before"],"after":v["patch"]["note"],
+                               "patch_sha256":r.digest(v["patch"])} for eid,v in proposed.items()},
+            "instruction":"Review each source-bound upstream delta. Is it a material correction, enrichment, "
+                          "false challenge, unsupported interpretation, or mere repeat? Return JSON with "
+                          "packet_sha256 echoing top level and decisions keyed by event ID. Each decision has "
+                          "decision APPLY, REJECT or HOLD, exact reason, and patch_sha256 echoing the candidate if APPLY. "
+                          "Read source first and authorize no empirical claims.",
+        })
+        result=invoke(jp,"feedback_judge",destination)
+        decisions = result.get("decisions", {})
+        inverted = {hash_:eid for eid,hash_ in jp["events"].items()}
+        if set(decisions)==set(inverted) and len(inverted)==len(jp["events"]):
+            r.save(destination/"FEEDBACK_REVIEW_ENVELOPE_NORMALIZATION.json",{
+                "original_sha256":r.digest(result),"exact_event_digest_to_id":inverted})
+            result={**result,"decisions":{inverted[k]:v for k,v in decisions.items()}}
+        reviewer=db.register(jp,result,"J","candidate")
+        for eid,value in proposed.items():
+            if value["rid"]=="D:Q93C" and "non-eligible" in value["patch"]["note"]:
+                with db.edit() as journal:
+                    journal["events"][eid].update(status="HELD_SOURCE_SCOPE",
+                        review=reviewer, hold="Code 7 is explicit; exact asked/eligible risk is unissued. Preserve the proposed note separately.")
+                dispositions[eid]="HELD_SOURCE_SCOPE"
+                continue
+            dispositions[eid]=db.adjudicate(eid,reviewer,owner=inherited[value["rid"]]["owner"],patch=value["patch"])
+    state=r.read(db.path)
+    if state["pending"]:
+        owner_packet=r.fa10.transport.seal({
+            "role":"I","source":edition,"fields":packets["recursive"]["fields"],
+            "affected":{rid:{"before":db.retrieve(rid),"parent_after":[db.retrieve(info["parent_after"]["record_id"])["record"]["content"]
+                       for info in changes.values()]} for rid,changes in state["pending"].items()},
+            "instruction":"Reconsider only these affected inquiry records against the changed parent. "
+                          "Return JSON dispositions by exact inquiry ID. Each has decision KEEP, REVISE, WITHDRAW or HOLD, "
+                          "reason, and note if REVISE. Keep missing form/risk, relation and reader effects visible.",
+        })
+        outcome=invoke(owner_packet,"affected_reader",destination)
+        values=outcome.get("dispositions",outcome)
+        r.require(set(values)==set(state["pending"]),"affected reader coverage")
+        for rid, value in values.items():
+            if rid=="I:O:EA_ROAD_C" and "non-response category 7" in value.get("note",""):
+                r.save(destination/"AFFECTED_READER_HOLD.json",{
+                    "worker_return":value,"reason":"7 is an explicit residual source answer, not a nonresponse code. Keep the two other fields' observation limitations separately."})
+                db.reconsider(rid,owner="I",decision="HOLD",rationale="Source contradicts automatic reclassification of code 7. Separate the field-level observation limitations.")
+            else:
+                db.reconsider(rid,owner="I",decision=value["decision"],rationale=value["reason"],
+                              patch={"note":value["note"]} if value["decision"]=="REVISE" else None)
+    r.require(untouched==r.reference(db.retrieve("I:unrelated")["record"]),"unaffected record drift")
+    r.save(destination/"ACTUAL_FEEDBACK.json",{
+        "dispositions":dispositions,"observed_model_receipts":True,"untouched_revision":untouched,
+        "records":{rid:db.retrieve(rid) for rid in r.read(db.path)["active"]},
+    })
+
+
+def afro():
+    prior=r.read(ROOT/"AFRO_REPAIR_INPUTS.json")
+    roadway, command = prior["roadway"], prior["command"]
+    inherited = {
+        "O:EA_ROAD_C":{"owner":"O","kind":"CORRECT",
+            "note":roadway["question"],
+            "dependent":roadway["alternatives"],"product_sha256":r.digest(roadway)},
+        "D:Q93C":{"owner":"D","kind":"ENRICH",
+            "note":command["positive"],
+            "dependent":"Compare expected recognition and sanctions with domestic violence jurisdiction.",
+            "product_sha256":r.digest(command)},
+    }
+    actual_feedback(*compare_case("afro_matched_feedback",wave="Afrobarometer Round 9 codebook.csv",
+                    ids=["EA_ROAD_C","EA_FAC_F","Q103","Q104","Q93C","Q53B","Q53C","Q54"],
+                    inherited=inherited,observation_focus="Journey into the EA, money command, anticipated recognition/sanction"),inherited)
+
+
+def adverse_core_review():
+    folder = WORK / "core_adverse"
+    packet_base = r.fa10.load_source()["author_base"]
+    source = packet_base["source"]
+    metadata = {**packet_base["selected"], **packet_base["context"]}
+    p = r.fa10.transport.seal({"role":"J","source":source,"fields":metadata,
+        "instruction":"Source-first independent encounter. Identify exact competing actors, answer distinctions, "
+                      "fused states, significant positive inquiries and a foil. Return JSON findings and unanswered. "
+                      "In Q48B determine the actor from exact source, without a historical answer key. "
+                      "Use exactly two JSON keys, findings and unanswered, both arrays of strings. At most six findings and three unanswered. Do not use field IDs as top-level keys."})
+    first = invoke(p,"source_first_compact",folder,5000)
+    products = {}
+    for arm,role in [("A","M"),("B","M"),("C","O"),("D","O")]:
+        d = r.read(ROOT / "core" / arm / role / "attempt-5/stdout.json")
+        candidate = d["response"]
+        if isinstance(candidate,dict):
+            products[arm] = {key:value for key,value in candidate.items() if key not in {"packet_sha256","grade"}}
+    blinded_review(source,metadata,products,folder,first,
+                   "These are frozen attempted fragments with structurally unequal coverage. "
+                   "Review observed useful substance and losses by exact items. Do not rank completeness or infer a factorial effect.")
+    r.save(folder/"ADVERSE_CORE_COMPLETENESS.json",r.read(ROOT/"core/CORE_STATUS.json"))
+
+
+def wvs():
+    comparison = WORK / "afro_matched_feedback"
+    review = r.read(comparison / "FROZEN_REVIEW.json")
+    transfer = r.read(comparison / "ACTUAL_FEEDBACK.json")
+    source, rows, ledger = r.verify_wvs(ARCHIVE)
+    d_packet=r.read(ROOT/"wvs_d/D_PACKET.json")
+    d_response=r.read(ROOT/"wvs_d/D_RESPONSE.json")
+    d_ledger=r.read(ROOT/"wvs_d/D_LEDGER.json")
+    r.verify_rows(d_packet["source_packet"],source,rows)
+    r.require(r.fa10.validate(d_packet,d_response),"WVS D bank structure")
+    r.require(set(d_ledger["records"])==set(rows) and len(rows)==613,"WVS D coverage")
+    ids=["Q279","Q280","Q281","Q282","Q284","Q285","Q286","Q287","Q288"]
+    eligible_scope={
+        "owner":"Codex HQ, bounded R only; Browser whole-wave D complete and may continue C",
+        "qualification":"R16 D bank records 613 D candidates and no new C/R/I/S; prior inherited variants retained",
+        "scope":"WVS R matched workplace/household clocks and monetary coping",
+        "existing_D_sha256":r.fa10.r9.sha((ROOT/"wvs_d/D_LEDGER.json").read_bytes()),
+        "existing_O_sha256":r.fa10.r9.sha((ROOT/"wvs/O_LEDGER.json").read_bytes()),
+        "actual_afro_review_sha256":r.digest(review),"actual_afro_feedback_sha256":r.digest(transfer),
+        "fields":ids,
+    }
+    inherited={}
+    for key in ids:
+        o = ledger["records"][key]
+        d = d_ledger["records"][key]
+        note = d.get("field_exception") or o.get("specific_observation_note") or ledger["rules"][o["rule"]]["response_act"]
+        inherited["D:"+key]={"owner":"D","kind":"ENRICH","note":note,"dependent":"Preserve this alternative in household labour-clock contrasts",
+                             "record_sha256":r.digest(d),"observation_sha256":r.digest(o)}
+    _, _, destination, _, results, verdict = compare_case(
+        "wvs_R_matched_transfer", wave="World Values Survey Wave 7 codebook.csv", ids=ids,
+        inherited=inherited,
+        observation_focus=("Transfer the Afrobarometer observation-owner test to WVS7. Determine which respondent or spouse "
+             "employment and occupational clocks are present, how relative chief wage earning differs from the power to decide "
+             "on household money, and whether a separate past-year savings/borrowing outcome is usable. "
+             "Test a counterexample with same chief-wage-earner answer and different household command, and a no-spouse "
+             "case. Addition to bounded R only. No new O or D ledger, no native compound inference."),
+    )
+    r.save(destination/"FRONTIER_RECEIPT.json",eligible_scope)
+    r.save(destination/"TRANSFER_PROVISIONAL.json",{"scope":eligible_scope,"products":results,"review":verdict})
+
+
+if __name__=="__main__":
+    os.umask(0o077)
+    r.csv.field_size_limit(10**7)
+    {"afro":afro,"adverse_review":adverse_core_review,"wvs":wvs}[sys.argv[1]]()
+
