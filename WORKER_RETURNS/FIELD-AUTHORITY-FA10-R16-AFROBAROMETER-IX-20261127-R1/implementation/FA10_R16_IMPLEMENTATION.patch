--- /dev/null
+++ b/summarize_economy.py
@@ -0,0 +1,45 @@
+import json
+from pathlib import Path
+from collections import defaultdict
+
+work=Path(".")
+calls=[]
+summary=defaultdict(lambda: defaultdict(float))
+for receipt in sorted((*work.glob("core/**/receipt.json"),*work.glob("experiments/**/receipt.json"))):
+    row=json.loads(receipt.read_text())
+    file=receipt.with_name("stdout.json")
+    if not file.exists() or not file.stat().st_size:
+        continue
+    stdout=json.loads(file.read_text())
+    info=stdout.get("provider_receipt") or {}
+    usage=stdout.get("usage")
+    group=receipt.parts[1]
+    call={
+        "path":str(receipt.parent),"provider_session":info.get("session"),
+        "model":stdout.get("model"),"effort":info.get("effort"),"cap":info.get("cap"),
+        "packet_sha256":row.get("packet_sha256"),"system_user_input_sha256":info.get("input_text_sha256"),
+        "output_sha256":row.get("stdout_sha256"),"seconds":row.get("elapsed_seconds"),
+        "transport_exit":row.get("exit_code"),"usage":usage,
+        "opencode_rate_equivalent":info.get("opencode_rate_cost") if usage else None,
+        "billed":None,
+    }
+    calls.append(call)
+    agg=summary[group]
+    agg["attempts"]+=1
+    agg["sum_call_elapsed_seconds"]+=row.get("elapsed_seconds") or 0
+    if usage:
+        agg["provider_returns"]+=1
+        for k in ("input","output","reasoning"):
+            agg[k]+=usage.get(k) or 0
+        agg["cache_read"]+=(usage.get("cache") or {}).get("read",0)
+        agg["opencode_rate_equivalent"]+=info.get("opencode_rate_cost") or 0
+out={
+    "execution":"OpenCode Go subscription, no separate DeepSeek API calls",
+    "rate_equivalent":"OpenCode model-rate accounting from step-finish events, not an invoice or subscription usage ledger",
+    "actual_billed":None,"human_active_minutes":None,"codex_tokens":None,
+    "usage_note":"OpenCode input and cache-read components are reported separately; per-call duration sums are not campaign wall time.",
+    "summary":summary,"calls":calls,
+}
+(work/"ECONOMICS.json").write_text(json.dumps(out,indent=2)+"\n")
+for k, value in summary.items():
+    print(k,dict(value))
