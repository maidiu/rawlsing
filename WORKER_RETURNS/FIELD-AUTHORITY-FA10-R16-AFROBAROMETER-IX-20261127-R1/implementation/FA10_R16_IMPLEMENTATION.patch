+"""Receive the out-of-role capital without importing a transformed frozen response."""
+from pathlib import Path
+import json
+
+import fa10_r16 as r
+
+root=Path(__file__).resolve().parent
+archive=Path.home()/"Desktop/Rawlsing/source_files/Rawlsing 35 waves of savs & dtas.zip"
+source, rows=r.fa10.r9.source(archive,"Afrobarometer Round 9 codebook.csv")
+home=root/"experiments/core_permeability"
+home.mkdir(exist_ok=True,parents=True)
+journal=r.Sidecar(home/"journal.json",source,rows,["C-arm","D-arm"],limit=14)
+for arm in ("C","D"):
+    raw_path=root/"core"/arm/"C/attempt-8/stdout.json"
+    raw=r.read(raw_path)["response"]
+    packet=r.read(raw_path.with_name("input.json"))
+    primary={**raw,"answer_notes":{},"inquiries":[],"nominations":[]}
+    r.require(r.fa10.validate(packet,primary),"nonsemantic primary extraction did not validate")
+    origin=journal.register(packet,primary,"C",arm+"-arm")
+    out=[]
+    packet_fields=packet["source_packet"]["selected"]|packet["source_packet"]["context"]
+    for n, promise in enumerate(raw["inquiries"]):
+        anchors=[]
+        for field in promise["items"]:
+            if field in packet_fields:
+                row=rows[field]
+                anchors.append({"source_sha256":source["sha256"],"locator":field,
+                    "quote_or_fact":row["question_text"],"row_sha256":r.digest(row),"evidence_kind":"LITERAL_ROW"})
+        if not anchors:
+            out.append({"inquiry":promise,"status":"HELD_NO_EXACT_SOURCE_ANCHOR"})
+            continue
+        e={
+            "schema":"FA10_FEEDBACK_EVENT@1","event_id":f"{arm}:C:I:{n}","grade":"PROPOSED_CANDIDATE",
+            "kind":"PRESERVE_OVERFLOW","origin":origin,"targets":[],"new_scope":"Future I review; bounded C experiment",
+            "evidence":anchors,"read_dependencies":[],"requested_operation":"CONSERVE",
+            "minimal_delta_or_request":json.dumps(promise,ensure_ascii=False),
+            "reason":"Actual C worker emitted a cross-role inquiry that the incumbent primary validator refused",
+            "intellectual_consequence":"Preserve candidate alternatives for I without auto-issue",
+            "known_affected":[],"dependency_scope":"CONSERVATIVE_SCOPE_REQUIRED",
+            "missing_evidence_or_authority":["No exact source-role and inquiry issuance"],
+            "effort_reason":"Keep unsolicited discoveries without regenerating coverage",
+        }
+        out.append({"event_id":e["event_id"],"status":journal.submit(e),"next_owner":"I"})
+    r.save(home/f"{arm}_RECEIPT.json",{"primary":primary,"raw_response_sha256":r.digest(raw),
+              "not_a_frozen_acceptance":True,"original_nominations":raw["nominations"],"inquiries":out})
+    print(arm,len(out))
