+def _tsv_rows(path):
+    lines=_rows(path); header=lines[0].split('\t'); out=[]
+    for line in lines[1:]:
+        if line.strip():
+            rec=dict(zip(header,line.split('\t'))); rec['_raw']=line; rec['_sha256']=sha(line.encode())
+            out.append(rec)
+    return header,out
+
+def _markdown_rows(path,prefix):
+    out=[]; lines=_rows(path)
