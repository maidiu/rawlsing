+    # Exact K3 row set/hash census against the source file, not against the inventory itself.
+    for g,fname in (('K1_CAP','K3_CAP_29.tsv'),('PYAT_PC','K3_PC_26.tsv'),('P4R','K3_P4R_14.tsv')):
