+    b=p.read_bytes()
+    d={'path':rel,'sha256':sha(b),'commit':commit,'git_path':git_path,'git_blob':git_blob,'bytes':len(b)}
+    for k in ('source_kind','zip_sha256'):
+        if extra and k in extra: d[k]=extra[k]
+    return d
