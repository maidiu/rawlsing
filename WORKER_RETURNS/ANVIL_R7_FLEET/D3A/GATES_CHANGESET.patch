+        if commit:m['commit']=commit
+        else:m['commit']=None
+        if zip_sha256:m['zip_sha256']=zip_sha256
+        else:m['zip_sha256']=None
+        return m
+
+    K3='D3A_SOURCE_SNAPSHOT/'
