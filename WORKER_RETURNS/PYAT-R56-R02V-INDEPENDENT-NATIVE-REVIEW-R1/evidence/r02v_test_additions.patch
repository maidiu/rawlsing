+def test_r02v_envelope_preserves_raw_declaration_and_binds_occurrence():
+    source_sha = "a" * 64
+    original_declaration = {"kind": "discrete", "value": -9.0}
+    cells = (
+        PhysicalCell(1, 1, "PID", 1.0,
