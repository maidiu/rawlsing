+    source = NativeSourceIdentity(
+        source_id=SOURCE_ID, family="SYNTHETIC", wave="W1",
+        canonical_filename="envelope.sav", declared_sha256=source_sha,
+        source_format="SAV", expected_rows=2)
+    package_ = NativeSourcePackage(
