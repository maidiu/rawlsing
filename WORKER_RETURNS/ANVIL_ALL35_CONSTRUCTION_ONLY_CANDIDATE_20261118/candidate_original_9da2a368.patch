+    semantic_use_scope: tuple[str, ...] | None = None,
+    body_sink: SourceI02BodySink | None = None,
+) -> SourceI02ConstructionOnlyResult:
+    """Build exact sourcefree C11 bodies without a Q2 analytical entrance.
+
+    This entry accepts no census, inventory, policy or scientific frontier.  It
+    preserves source metadata but reports all analytical dimensions UNRESOLVED:
+    the result cannot be represented as a joined Q2, eligible or issued workload.
+    Original sources still require the exact request/current resolver before
+    the first source byte is decoded.
+    """
+    if not isinstance(config, SourceConfig):
+        config = SourceConfig(config)
+    doc = config.document
+    target = Path(destination).absolute()
+    if (target.suffix != ".sqlite" or target.exists() or target.is_symlink()
+            or not target.parent.is_dir() or target.parent.is_symlink()):
+        raise SourceI02Refusal(
+            "OUTPUT_DESTINATION_INVALID",
+            "new non-symlink .sqlite destination in an existing private directory required",
+        )
+    slot = doc["respondents"].get("source_native_key_slot")
+    if slot is not None and row_native_keys is None:
+        raise SourceI02Hold(
+            "KEY_WITNESS_REQUIRED",
+            "configured source_native_key_slot requires independently derived row_native_keys",
+        )
+    projection = build_governed_c11_projection(
+        config,
+        source_sha256=doc["binding"]["source_sha256"],
+        row_count=doc["binding"]["row_count"],
+        row_native_keys=row_native_keys,
+    )
+    if universe_ref is None:
+        universe_ref = projection.universes[0].ref
+    body = _construct_source_bodies(
+        config=config, projection=projection, source_path=source_path,
+        target=target, row_native_keys=row_native_keys,
+        universe_ref=universe_ref, batch_size=batch_size,
+        chunk_size=chunk_size, resolver=resolver, host=host, purpose=purpose,
+        consumer_use=consumer_use, semantic_use_scope=semantic_use_scope,
+        body_sink=body_sink, operation_hook=None,
+    )
+    return SourceI02ConstructionOnlyResult(
+        schema="PYAT960_SOURCE_I02_CONSTRUCTION_ONLY@1",
+        destination=str(target), roots=body.roots, manifest=body.manifest,
+        counts=body.counts, universe_ref=universe_ref,
+        source_sha256=doc["binding"]["source_sha256"],
+        row_count=body.stats.source_rows,
+        stats=body.stats,
+        source_metadata={
+            "source_id": config.source_id,
+            "config_id": config.config_id,
+            "identity_class": config.identity_class,
+            "source_format": doc["identity"]["source_format"],
+            "source_sha256": config.active_source_sha256,
+        },
+        unresolved_states={
+            "source_inventory": "ABSENT_NOT_REQUIRED",
+            "grammar_policy": "ABSENT_NOT_REQUIRED",
+            "scientific_frontier": "ABSENT_NOT_REQUIRED",
+            "frozen_input_census": "ABSENT_NOT_REQUIRED",
+            "operation_eligibility": "UNRESOLVED_NOT_EVALUATED",
+            "operation_fates": "ABSENT_NOT_EVALUATED",
+            "analytical_issuance": "NOT_ISSUED",
+            "joined_q2": "FALSE",
+        },
+        body_transport=body.body_transport,
+        qualified_metadata_only=True,
+        joined_q2=False,
+        authorized_executable_q2=False,
+        issued_workload=False,
+    )
