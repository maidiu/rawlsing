@@ -0,0 +1,99 @@
+"""Focused candidate test: construction-only entry beside governed Q2."""
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+
+pytest.importorskip("pyarrow")
+
+from rawlsing_next.pre553_source_i02_handoff import (
+    SourceI02ConstructionOnlyResult,
+    SourceI02Handoff,
+    build_source_i02_construction_only,
+    build_source_i02_handoff,
+)
+from rawlsing_next.pre553_source_i02_streams import ALL_FAMILIES
+from rawlsing_next.pre553_r157_projection_adapter import SourceReadAdmissionRefusal
+from rawlsing_next.pre553_source_saved_body_bridge import SourceSavedBodySink
+from rawlsing_next.pre553_source_direct_parquet_estate import VerifiedDirectEstate
+from rawlsing_next.tests.test_pyat960_s1e_support import (
+    DenyResolver, source_fixture,
+)
+
+
+def _cold(private: Path, receipt):
+    return VerifiedDirectEstate(
+        private, exact_path=receipt.path,
+        independently_held_manifest_sha256=receipt.manifest_sha256,
+        independently_held_i02=receipt.i02,
+        current_authorizer=lambda _roots: True,
+    )
+
+
+def test_construction_only_build_and_independent_fresh_reopen(tmp_path):
+    fixture = source_fixture(tmp_path / "src")
+    private = tmp_path / "private"
+    private.mkdir(mode=0o700)
+    dest = tmp_path / "direct.sqlite"
+    sink = SourceSavedBodySink(
+        certificate_path=dest, authorized_private_root=private, chunk_rows=2,
+    )
+    result = build_source_i02_construction_only(
+        config=fixture["config"], source_path=fixture["path"],
+        destination=dest, body_sink=sink, chunk_size=2,
+    )
+    assert isinstance(result, SourceI02ConstructionOnlyResult)
+    assert isinstance(result, SourceI02Handoff) is False
+    assert result.qualified_metadata_only is True
+    assert result.joined_q2 is False
+    assert result.authorized_executable_q2 is False
+    assert result.issued_workload is False
+    assert not hasattr(result, "operation_fates")
+    assert not hasattr(result, "census_audit")
+    assert result.unresolved_states["operation_eligibility"] == "UNRESOLVED_NOT_EVALUATED"
+    assert result.unresolved_states["analytical_issuance"] == "NOT_ISSUED"
+    assert result.source_metadata["source_id"] == fixture["config"].source_id
+    assert result.source_metadata["identity_class"] == fixture["config"].identity_class
+    assert result.source_sha256 == fixture["source_sha"]
+    assert result.stats.source_reads == 1
+    assert result.stats.cell_passes == 1
+    assert result.stats.full_c11_builds == 0
+    assert result.roots == sink.receipt.i02
+    assert Path(result.destination).is_file()
+    cold = _cold(private, sink.receipt)
+    for family in ALL_FAMILIES:
+        bodies = tuple(cold.iter_family(family, batch_size=3))
+        assert len(bodies) == result.counts[family], family
+    events = tuple(cold.iter_family("RespondentEvent"))
+    identities = tuple(cold.iter_family("RespondentIdentity"))
+    routing = tuple(cold.iter_family("RoutingEligibilityFact"))
+    assert len(events) == len(identities) == fixture["rows"]
+    assert routing
+    assert {
+        event.scoped_respondent_ref["object_id"] for event in events
+    } <= {identity.ref.object_id for identity in identities}
+    assert result.body_transport["complete"] is True
+    assert result.unresolved_states["joined_q2"] == "FALSE"
+
+
+def test_original_missing_resolver_refuses_before_source_bytes(tmp_path, monkeypatch):
+    fixture = source_fixture(tmp_path / "src-original", original=True)
+    dest = tmp_path / "denied.sqlite"
+    import rawlsing_next.pre553_source_i02_handoff as handoff_mod
+    calls = []
+
+    def forbidden(*args, **kwargs):
+        calls.append(1)
+        raise AssertionError("source bytes were decoded")
+
+    monkeypatch.setattr(handoff_mod, "decode_sav", forbidden)
+    monkeypatch.setattr(handoff_mod, "decode_dta", forbidden)
+    with pytest.raises(SourceReadAdmissionRefusal, match="SOURCE_READ_NOT_CURRENT"):
+        build_source_i02_construction_only(
+            config=fixture["config"], source_path=fixture["path"],
+            destination=dest, resolver=DenyResolver(), host="h", purpose="p",
+            consumer_use="c", semantic_use_scope=("S1E_SOURCEFREE",),
+        )
+    assert calls == []
+    assert not dest.exists()
