  "mandatory_refusals": [
    {
      "id": "REF-01",
      "rule": "A row-data read for any source whose plan row_data_mode admits no row data must be refused BEFORE it executes.",
      "sources_affected": [
        "SRC08",
        "SRC12",
        "SRC26"
      ]
    },
    {
      "id": "REF-02",
      "rule": "A header-prefix read for any source whose plan does not admit one must be refused BEFORE it executes.",
      "sources_affected": [
