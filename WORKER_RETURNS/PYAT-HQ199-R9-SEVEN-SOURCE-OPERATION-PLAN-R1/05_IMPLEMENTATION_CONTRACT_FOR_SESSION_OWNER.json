        "SRC12",
        "SRC14",
        "SRC27"
      ]
    },
    {
      "id": "REF-03",
      "rule": "For SRC08/SRC12 the declared encoding configures the reader but must never select a row-data mode.",
      "why": "reader configuration is independent of row-data mode; this is the exact defect observed in the accepted candidate."
    },
    {
      "id": "REF-04",
      "rule": "A second decoder entry for the same source must be refused.",
      "authority_status": "IMPLEMENTATION_POLICY_CANDIDATE",
      "ceiling": "MAX 1 per source session"
    },
    {
      "id": "REF-05",
      "rule": "iter_batches / iter_cells must be refused for any source whose plan admits no row data.",
      "sources_affected": [
        "SRC08",
        "SRC12",
        "SRC26"
      ],
      "why": "closes latent risk MIS-LATENT-004"
    },
    {
      "id": "REF-06",
      "rule": "The outer Route-B pass quantity must be recorded as its own account and must never be summed into, or substituted for, any lower-layer account.",
