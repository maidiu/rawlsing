      "value": "exactly 1, max 1"
    },
    {
      "id": "REF-07",
      "rule": "No numeric byte ceiling may be asserted from a synthetic carrier total or from source size.",
      "authority_status": "PROHIBITED unless a governing rule is supplied"
    }
  ],
