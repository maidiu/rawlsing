{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rawlsing.local/schemas/p3/v5/internal_pair_record.schema.json",
  "title": "internal_pair_record",
  "type": "object",
  "required": [
    "candidate_revision_id",
    "left_object_id",
    "right_object_id",
    "pair_state",
    "direct_pair_fact_id"
  ],
  "properties": {
    "candidate_revision_id": {
      "type": "string",
      "pattern": "^P3CANDREV-[0-9]{6}-R[0-9]{4}$"
    },
    "left_object_id": {
      "type": "string",
      "minLength": 1
    },
    "right_object_id": {
      "type": "string",
      "minLength": 1
    },
    "pair_state": {
      "enum": [
        "DIRECT_POSITIVE",
        "DIRECT_COLLISION",
        "DIRECT_UNRESOLVED",
        "HIERARCHICAL_ONLY",
        "UNRULED",
        "SIGNATURE_CONFLICT",
        "SIGNATURE_COMPATIBLE"
      ]
    },
    "direct_pair_fact_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^P3PF-[0-9a-f]{16}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false
}
