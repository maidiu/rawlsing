{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rawlsing.local/schemas/p3/v5/component_connectivity_edge.schema.json",
  "title": "component_connectivity_edge",
  "type": "object",
  "required": [
    "component_id",
    "pair_fact_id",
    "authority_release_id"
  ],
  "properties": {
    "component_id": {
      "type": "string",
      "pattern": "^P3COMP-[0-9a-f]{16}$"
    },
    "pair_fact_id": {
      "type": "string",
      "pattern": "^P3PF-[0-9a-f]{16}$"
    },
    "authority_release_id": {
      "type": "string",
      "pattern": "^P3-AUTHORITY-[0-9]{4}-[0-9]{2}-[0-9]{2}-R[0-9]+$"
    }
  },
  "additionalProperties": false
}
