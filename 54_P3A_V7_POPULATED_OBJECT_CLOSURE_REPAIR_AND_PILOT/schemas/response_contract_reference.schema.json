{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rawlsing.local/schemas/p3/v7/response_contract_reference.schema.json",
  "title": "response_contract_reference",
  "type": "object",
  "required": [
    "reference_id",
    "subject_id",
    "response_topology",
    "authority_artifact",
    "p4_authority",
    "authority_release_id"
  ],
  "properties": {
    "reference_id": {
      "type": "string",
      "pattern": "^P3RCR-[0-9a-f]{16}$"
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "upstream_response_contract_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "response_topology": {
      "enum": [
        "ADMINISTRATIVE",
        "BINARY",
        "DERIVED_INDEX",
        "FORCED_CHOICE",
        "FREQUENCY_ORDINAL",
        "LIKERT",
        "MULTISELECT",
        "NOMINAL",
        "NUMERIC_OPEN",
        "ORDINAL",
        "RANKING",
        "TEXT_OPEN",
        "UNKNOWN"
      ]
    },
    "response_contract_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "authority_artifact": {
      "type": "string",
      "minLength": 1
    },
    "p4_authority": {
      "const": false
    },
    "authority_release_id": {
      "type": "string",
      "pattern": "^P3-AUTHORITY-[0-9]{4}-[0-9]{2}-[0-9]{2}-R[0-9]+$"
    }
  },
  "additionalProperties": false
}
