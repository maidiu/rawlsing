            "field_value": {
              "type": [
                "string",
                "null"
              ]
            },
            "normalized_value_code": {
              "type": [
                "string",
                "null"
              ],
              "description": "Optional governed code or stable value-registry ID; free-text source value remains in field_value."
            },
            "evidence_state": {
              "enum": [
                "KNOWN",
                "EXPLICITLY_UNSPECIFIED",
                "NOT_APPLICABLE",
                "UNRECOVERED",
                "HETEROGENEOUS",
                "CONFLICTING",
                "DIAGNOSTIC_ONLY"
              ]
            },
            "confidence": {
              "enum": [
                "HIGH",
                "MEDIUM",
                "LOW",
                "NOT_APPLICABLE"
              ]
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "evidence_state": {
                    "const": "KNOWN"
                  }
                },
                "required": [
                  "evidence_state"
                ]
              },
              "then": {
                "properties": {
                  "field_value": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence_ids": {
                    "minItems": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "evidence_state": {
                    "enum": [
                      "EXPLICITLY_UNSPECIFIED",
                      "NOT_APPLICABLE",
                      "UNRECOVERED"
                    ]
                  }
                },
                "required": [
                  "evidence_state"
                ]
              },
              "then": {
                "properties": {
                  "field_value": {
                    "type": "null"
                  }
                }
              }
            }
