  "$id": "https://rawlsing.local/schemas/p3/v2/proposition_signature.schema.json",
  "title": "Rawlsing P3 Proposition Signature",
  "type": "object",
  "required": [
    "signature_id",
    "subject_id",
    "subject_type",
    "fields",
    "response_topologies",
    "signature_status",
    "content_hash",
    "authority_release_id"
  ],
  "properties": {
    "signature_id": {
      "type": "string",
      "pattern": "^P3SIG-[0-9]{6}$"
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_type": {
