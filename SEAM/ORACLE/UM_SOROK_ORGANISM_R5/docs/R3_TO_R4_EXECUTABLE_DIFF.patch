+                    changes.append({'kind':'ACQUIRED_DIFFERENCE_IN_ENACTMENT',
+                                    'discrimination':ref,'origin_events':new['origin_events'],
+                                    'no_inferred_motive':True})
+        return changes
+
+    def orient(self,const,access):
