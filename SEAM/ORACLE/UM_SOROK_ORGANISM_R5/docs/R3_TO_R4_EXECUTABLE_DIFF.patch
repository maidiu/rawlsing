+            hits=sorted(set(orient['cue_terms'])&observed)
+            if hits and any(orient['id'] in c.get('actor_attention_refs',[]) for c in access.cues):
+                currents.append({'kind':'NONCONCEPTUAL_ACQUIRED_ORIENTATION',
